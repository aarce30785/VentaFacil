@model VentaFacil.web.Models.Dto.InventarioDto

@{
    ViewData["Title"] = "Editar Insumo";
    Layout = "_LayoutPlantilla";
}

<!-- ========== table components start ========== -->
<div class="container-fluid py-4">
    <!-- Header -->
    <div class="hero-section d-flex justify-content-between align-items-center px-4" style="text-align: left; margin-top: -1.5rem; margin-bottom: 2rem;">
        <div class="position-relative z-1">
            <h1 class="hero-title fw-bold mb-2 text-white"><i class="lni lni-pencil-alt me-2"></i>Editar Insumo</h1>
            <p class="mb-0 text-white-50 fs-5">Modifica los datos del insumo seleccionado.</p>
        </div>
        <div class="position-relative z-1 d-none d-md-block">
            <div class="breadcrumb-wrapper">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="#0" class="text-white-50">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Listar")" class="text-white-50">Inventario</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Editar</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="tables-wrapper">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="premium-card p-4 shadow-sm border-0">
                    <div class="p-4 border-bottom mb-4 bg-light bg-opacity-50 rounded-3 d-flex align-items-center">
                        <div class="icon-box bg-primary bg-opacity-10 text-primary rounded-3 me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                            <i class="lni lni-pencil-alt"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Editar Insumo</h5>
                            <p class="text-xs text-muted mb-0">Actualice la información del registro seleccionado.</p>
                        </div>
                    </div>

                    <form asp-action="Editar" class="px-2">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger rounded-3 p-3 mb-4"></div>
                        <input type="hidden" asp-for="Id_Inventario" />

                        <div class="row g-4 mb-5">
                            <div class="col-md-7">
                                <label asp-for="Nombre" class="form-label text-xs fw-bold text-muted text-uppercase mb-2 ms-2">Nombre del Insumo</label>
                                <input asp-for="Nombre" class="form-control rounded-pill bg-light border-0 px-4 py-2" placeholder="Ej. Tomates, Harina, etc." required />
                                <span asp-validation-for="Nombre" class="text-xs text-danger mt-1 ms-2"></span>
                            </div>

                            <div class="col-md-5">
                                <label asp-for="UnidadMedida" class="form-label text-xs fw-bold text-muted text-uppercase mb-2 ms-2">Unidad de Medida</label>
                                <select asp-for="UnidadMedida" class="form-select rounded-pill bg-light border-0 px-4 py-2" asp-items="Html.GetEnumSelectList<VentaFacil.web.Models.Enum.UnidadMedida>()">
                                    <option value="">Seleccione una unidad</option>
                                </select>
                                <span asp-validation-for="UnidadMedida" class="text-xs text-danger mt-1 ms-2"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="StockActual" class="form-label text-xs fw-bold text-muted text-uppercase mb-2 ms-2">Stock Actual</label>
                                <div class="input-group">
                                    <span class="input-group-text rounded-start-pill px-3 bg-light border-end-0 text-muted fw-bold"><i class="lni lni-package"></i></span>
                                    <input asp-for="StockActual" class="form-control rounded-end-pill px-4 bg-light" type="number" min="0" step="0.01" />
                                </div>
                                <span asp-validation-for="StockActual" class="text-xs text-danger mt-1 ms-2"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="StockMinimo" class="form-label text-xs fw-bold text-muted text-uppercase mb-2 ms-2 text-danger">Stock Mínimo de Alerta</label>
                                <div class="input-group">
                                    <span class="input-group-text rounded-start-pill px-3 bg-danger bg-opacity-10 text-danger border-0 border-end fw-bold"><i class="lni lni-warning"></i></span>
                                    <input asp-for="StockMinimo" class="form-control rounded-end-pill px-4 border-0" type="number" min="0" step="0.01" />
                                </div>
                                <span asp-validation-for="StockMinimo" class="text-xs text-danger mt-1 ms-2"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-4 border-top">
                            <a href="@Url.Action("Listar")" class="main-btn dark-btn-outline btn-hover rounded-pill px-4 py-2">
                                <i class="lni lni-arrow-left me-2"></i> Cancelar
                            </a>
                            <button type="submit" class="main-btn primary-btn btn-hover rounded-pill px-5 py-2">
                                <i class="lni lni-save me-2"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<!-- ========== table components end ========== -->
