@using VentaFacil.web.Models.Response.Planilla
@using VentaFacil.web.Models.Dto
@model HistorialLaboralResponse
@{
    var cultureCR = new System.Globalization.CultureInfo("es-CR");
    var numFmt = (System.Globalization.NumberFormatInfo)cultureCR.NumberFormat.Clone();
    numFmt.CurrencySymbol = "¢";
    bool esAdmin = (bool)(ViewBag.EsAdmin ?? false);
}

<div class="historial-laboral-wrapper">
    <div class="hero-section d-flex flex-column flex-md-row justify-content-between align-items-center px-4 mb-4" style="margin-top: -1.5rem;">
        <div class="position-relative z-1 text-center text-md-start mb-3 mb-md-0 d-flex align-items-center gap-3">
            <div class="icon-box bg-white bg-opacity-20 text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                <i class="lni lni-history fs-4"></i>
            </div>
            <div>
                <h1 class="hero-title fw-bold mb-1 text-white">Historial Laboral</h1>
                <p class="mb-0 text-white-50 fs-6">Resumen de jornadas y remuneraciones de @Model.NombreUsuario.</p>
            </div>
        </div>
        <div class="position-relative z-1 d-none d-md-block text-end">
            <div class="breadcrumb-wrapper">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0 justify-content-end">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="text-white-50">Inicio</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Planilla")" class="text-white-50">Planilla</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Historial</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

<div class="row">
    <div class="col-12">

    <div class="mx-4">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible bg-danger text-white border-0 fade show mb-4" role="alert">
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                <i class="lni lni-warning me-2"></i> @TempData["Error"]
            </div>
        }

        @if (esAdmin)
        {
            <div class="premium-card p-4 mb-4">
                <form method="get">
                    <div class="row align-items-end g-3">
                        <div class="col-md-6">
                            <label class="form-label text-xs fw-bold text-muted text-uppercase mb-2 ms-2">Seleccionar Colaborador</label>
                            <select name="idUsuario" asp-items="ViewBag.Usuarios" class="form-select rounded-pill" onchange="this.form.submit()">
                                <option value="">-- Elija un empleado para ver su historial --</option>
                            </select>
                        </div>
                        <div class="col-md-6 text-end">
                            <p class="text-muted small mb-0 mt-2"><i class="lni lni-information me-1"></i> Mostrando datos consolidados de los últimos 5 años.</p>
                        </div>
                    </div>
                    <input type="hidden" name="pagina" value="1" />
                </form>
            </div>
        }

        <div class="premium-card p-0 overflow-hidden mb-5 shadow-sm border-0">
            <div class="p-4 border-bottom d-flex justify-content-between align-items-center bg-light bg-opacity-50">
                <div class="d-flex align-items-center">
                    <div class="icon-box bg-primary bg-opacity-10 text-primary rounded-3 me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                        <i class="lni lni-library"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Listado de Jornadas <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 ms-2 fs-7 px-3">@Model.TotalRegistros registros</span></h5>
                </div>
                @if (!esAdmin)
                {
                    <a asp-action="Index" asp-controller="Planilla" class="main-btn dark-btn-outline btn-hover btn-sm rounded-pill px-4">
                        <i class="lni lni-arrow-left me-1"></i> Volver
                    </a>
                }
            </div>

            <div class="table-responsive">
                <table class="table premium-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Fecha Jornada</th>
                            <th class="text-center">Entrada</th>
                            <th class="text-center">I. Pausa</th>
                            <th class="text-center">F. Pausa</th>
                            <th class="text-center">Salida</th>
                            <th class="text-center">Hrs Trab.</th>
                            <th class="text-center">Extras</th>
                            <th class="text-end">Bruto</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center pe-4">Nómina</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Jornadas != null && Model.Jornadas.Any())
                        {
                            @foreach (var j in Model.Jornadas)
                            {
                                <tr>
                                    <td class="fw-semibold">@j.FechaInicio.ToString("ddd dd/MM/yyyy", cultureCR)</td>
                                    <td class="text-center">@j.FechaInicio.ToString("HH:mm")</td>
                                    <td class="text-center">@(j.HoraInicioPausa?.ToString("HH:mm") ?? "—")</td>
                                    <td class="text-center">@(j.HoraFinPausa?.ToString("HH:mm") ?? "—")</td>
                                    <td class="text-center">@(j.FechaFinal?.ToString("HH:mm") ?? "—")</td>
                                    <td class="text-center">@j.HorasTrabajadas.ToString("0.##") h</td>
                                    <td class="text-center">@j.HorasExtras.ToString("0.##") h</td>
                                    <td class="text-end">@j.SalarioBruto.ToString("C", numFmt)</td>
                                    <td class="text-center">
                                        @if (j.EstadoRegistro == "Completada")
                                        {
                                            <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3">Completada</span>
                                        }
                                        else if (j.EstadoRegistro == "Incompleta")
                                        {
                                            <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3">Incompleta</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25 px-3">@j.EstadoRegistro</span>
                                        }
                                    </td>
                                    <td class="text-center pe-4">
                                        @if (j.Id_Nomina.HasValue)
                                        {
                                            <a href="@Url.Action("DetalleNomina","Planilla", new {idNomina=j.Id_Nomina})"
                                               class="main-btn primary-btn-outline btn-hover btn-sm rounded-pill px-3 py-1" title="Ver Nómina #@j.Id_Nomina">
                                                <i class="lni lni-empty-file me-1"></i> #@j.Id_Nomina
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted text-xs">Sin nómina</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5 text-muted pe-4">
                                    <div class="empty-state">
                                        <i class="lni lni-empty-file fs-1 mb-3 opacity-25"></i>
                                        <p class="mb-0">No se encontraron jornadas en los últimos 5 años para este usuario.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Paginación *@
            @if (Model.TotalPaginas > 1)
            {
                <div class="p-4 border-top">
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-premium justify-content-end mb-0">
                            <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                                <a class="page-link shadow-sm" href="@Url.Action("HistorialLaboral","Planilla", new {idUsuario=Model.Id_Usr, pagina=Model.PaginaActual-1})" aria-label="Previous">
                                    <i class="lni lni-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = 1; i <= Model.TotalPaginas; i++)
                            {
                                <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                                    <a class="page-link shadow-sm" href="@Url.Action("HistorialLaboral","Planilla", new {idUsuario=Model.Id_Usr, pagina=i})">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                                <a class="page-link shadow-sm" href="@Url.Action("HistorialLaboral","Planilla", new {idUsuario=Model.Id_Usr, pagina=Model.PaginaActual+1})" aria-label="Next">
                                    <i class="lni lni-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>
