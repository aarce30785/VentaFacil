@{
    ViewData["Title"] = "Dashboard";
    Layout = "_LayoutPlantilla";
}

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        --success-gradient: linear-gradient(135deg, #10b981 0%, #059669 100%);
        --warning-gradient: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        --danger-gradient: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        --info-gradient: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        --secondary-gradient: linear-gradient(135deg, #64748b 0%, #475569 100%);
        --card-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        --hover-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }

    .premium-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: var(--card-shadow);
        transition: all 0.3s ease;
        border: 1px solid rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .premium-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--hover-shadow);
    }

    .stat-card {
        padding: 1.5rem;
        display: flex;
        align-items: center;
    }

    .stat-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        margin-right: 1.25rem;
    }

    .bg-gradient-primary { background: var(--primary-gradient); color: white; }
    .bg-gradient-success { background: var(--success-gradient); color: white; }
    .bg-gradient-warning { background: var(--warning-gradient); color: white; }
    .bg-gradient-danger { background: var(--danger-gradient); color: white; }
    .bg-gradient-info { background: var(--info-gradient); color: white; }

    .section-title {
        font-weight: 700;
        color: #1e293b;
        font-size: 1.1rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
    }
    
    .section-title i {
        margin-right: 0.5rem;
        color: #6366f1;
    }
</style>

<div class="dashboard-wrapper">
    <!-- Hero Section -->
    <div class="hero-section d-flex flex-column flex-md-row justify-content-between align-items-center px-4" style="text-align: left; margin-top: -1.5rem; margin-bottom: 2rem;">
        <div class="position-relative z-1 text-center text-md-start mb-3 mb-md-0">
            <h1 class="hero-title fw-bold mb-2 text-white">¡Hola, @User.Identity?.Name! 👋</h1>
            <p class="mb-0 text-white-50 fs-5">Resumen de actividad operativa</p>
        </div>
        
    </div>
@model VentaFacil.web.Models.ViewModel.DashboardViewModel

@if (Model.MostrarAlertaCajaAbierta)
{
    <div class="alert alert-warning alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style="border-radius: 12px; background-color: #fffbeb; border-left: 5px solid #f59e0b !important;">
        <div class="d-flex align-items-center">
            <div class="stat-icon bg-gradient-warning me-3" style="width: 40px; height: 40px; font-size: 1.2rem;">
                <i class="lni lni-warning"></i>
            </div>
            <div>
                <h5 class="alert-heading fw-bold mb-1" style="color: #92400e;">Caja Abierta Olvidada</h5>
                <p class="mb-0" style="color: #b45309;">Se han detectado cajas que no fueron cerradas en días anteriores. El sistema las cerrará automáticamente.</p>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Header Actions -->
<div class="premium-card mb-4 p-4">
    <div class="row align-items-center g-3">
        <div class="col-12 col-lg-6">
            <div class="d-flex align-items-center justify-content-center justify-content-lg-start">
                <div class="avatar bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                    <i class="lni lni-home fs-4"></i>
                </div>
                <div class="text-start">
                    <h6 class="mb-0">Resumen General</h6>
                    <p class="text-sm text-muted mb-0">Estado del Negocio</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6 text-center text-lg-end">
            <div class="d-flex flex-wrap justify-content-center justify-content-lg-end gap-2">
                <a asp-controller="Pedidos" asp-action="Cocina" class="main-btn dark-btn-outline btn-hover rounded-pill px-4">
                    <i class="lni lni-chef-hat me-2"></i> Cocina
                </a>
                <a asp-controller="Pedidos" asp-action="Crear" class="main-btn primary-btn btn-hover rounded-pill px-4">
                    <i class="lni lni-plus me-2"></i> Nuevo Pedido
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Sales Stats Grid -->
<div class="row g-4 mb-4">
    <!-- Ventas Hoy -->
    <div class="col-xl-3 col-md-6">
        <div class="premium-card stat-card">
            <div class="stat-icon bg-gradient-info">
                <i class="lni lni-stats-up"></i>
            </div>
            <div>
                <h3 class="mb-0 fw-bold">@Model.VentasDia.ToString("C", new System.Globalization.CultureInfo("es-CR"))</h3>
                <span class="text-sm text-muted">Ventas Hoy</span>
            </div>
        </div>
    </div>

    <!-- Ventas Semana -->
    <div class="col-xl-3 col-md-6">
        <div class="premium-card stat-card">
            <div class="stat-icon bg-gradient-primary">
                <i class="lni lni-graph"></i>
            </div>
            <div>
                <h3 class="mb-0 fw-bold">@Model.VentasSemana.ToString("C", new System.Globalization.CultureInfo("es-CR"))</h3>
                <span class="text-sm text-muted">Ventas Semana</span>
            </div>
        </div>
    </div>

    <!-- Ventas Mes -->
    <div class="col-xl-3 col-md-6">
        <div class="premium-card stat-card">
            <div class="stat-icon bg-gradient-success">
                <i class="lni lni-pie-chart"></i>
            </div>
            <div>
                <h3 class="mb-0 fw-bold">@Model.VentasMes.ToString("C", new System.Globalization.CultureInfo("es-CR"))</h3>
                <span class="text-sm text-muted">Ventas Mes</span>
            </div>
        </div>
    </div>

    <!-- Caja -->
    <div class="col-xl-3 col-md-6">
        <div class="premium-card stat-card">
            <div class="stat-icon bg-gradient-warning">
                <i class="lni lni-wallet"></i>
            </div>
            <div>
                <h3 class="mb-0 fw-bold">@((Model.IngresosRecientes - Model.GastosRecientes).ToString("C", new System.Globalization.CultureInfo("es-CR")))</h3>
                <span class="text-sm text-muted">Balance Caja</span>
            </div>
        </div>
    </div>

    <div class="row g-4 pb-5">
        <!-- Productos Más Vendidos -->
        <div class="col-lg-8">
            <div class="premium-card p-4 h-100">
                <div class="section-title">
                    <i class="lni lni-star-filled"></i>
                    Productos Más Vendidos
                </div>
                
                @if (Model.ProductosMasVendidos.Any())
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="text-secondary text-uppercase fs-7 bg-light">
                                <tr>
                                    <th class="border-0 rounded-start ps-3">Producto</th>
                                    <th class="border-0 text-center">Unidades</th>
                                    <th class="border-0 text-end rounded-end pe-3">Popularidad</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prod in Model.ProductosMasVendidos.Take(5))
                                {
                                    <tr>
                                        <td class="ps-3 border-0 py-3">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar bg-primary bg-opacity-7 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                    <i class="lni lni-tag"></i>
                                                </div>
                                                <span class="fw-bold text-dark">@prod.Nombre</span>
                                            </div>
                                        </td>
                                        <td class="text-center border-0 py-3">
                                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3">@prod.CantidadVendida</span>
                                        </td>
                                        <td class="text-end pe-3 border-0 py-3">
                                            <div class="progress" style="height: 6px; width: 100px; display: inline-flex; border-radius: 10px;">
                                                <div class="progress-bar bg-primary" role="progressbar" style="width: @Math.Min(100, prod.CantidadVendida * 5)%" aria-valuenow="@prod.CantidadVendida" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                     <div class="text-center py-5 text-muted">
                        <i class="lni lni-sad fs-1 mb-3 d-block opacity-50"></i>
                        No hay ventas registradas aún.
                    </div>
                }
            </div>
        </div>

        <!-- Alertas de Stock -->
        <div class="col-lg-4">
            <div class="premium-card p-4 h-100">
                <div class="section-title">
                    <i class="lni lni-warning text-danger"></i>
                    Alertas de Stock
                </div>

                @if (Model.StockMinimo.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model.StockMinimo.Take(5))
                        {
                            <div class="list-group-item px-0 border-0 mb-2">
                                <div class="d-flex align-items-center justify-content-between w-100">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar bg-danger bg-opacity-10 text-danger rounded flex-shrink-0 d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                            <i class="lni lni-alert"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold text-dark">@item.Nombre</h6>
                                            <small class="text-danger fw-semibold">@item.StockActual en stock</small>
                                        </div>
                                    </div>
                                    <span class="badge bg-light text-secondary border rounded-pill">Min: @item.StockMinimo</span>
                                </div>
                            </div>
                        }
                    </div>
                     @if (Model.StockMinimo.Count > 5)
                     {
                        <div class="text-center mt-3">
                            <a asp-controller="Inventario" asp-action="Listar" class="btn btn-sm btn-outline-danger rounded-pill px-4">Ver Todos</a>
                        </div>
                     }
                }
                else
                {
                    <div class="text-center py-5 text-success">
                        <div class="mb-3">
                            <i class="lni lni-checkmark-circle fs-1 opacity-50"></i>
                        </div>
                        <h6 class="fw-bold">¡Todo en orden!</h6>
                        <p class="small opacity-75 mb-0">No hay productos con stock bajo.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
