@model List<VentaFacil.web.Models.Dto.PedidoDto>
@using VentaFacil.web.Models.Enum

@{
    Layout = "_LayoutPlantilla";
    ViewData["Title"] = "Panel de Mesas";
    int totalMesas = ViewBag.TotalMesas as int? ?? 20;
    var mesasOcupadas = Model.Where(p => p.NumeroMesa > 0).Select(p => p.NumeroMesa).Distinct().Count();
    int mesasLibres = totalMesas - mesasOcupadas;

    var cultureCR = new System.Globalization.CultureInfo("es-CR");
    var numberFormat = (System.Globalization.NumberFormatInfo)cultureCR.NumberFormat.Clone();
    numberFormat.CurrencySymbol = "¢";
}

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        --success-gradient: linear-gradient(135deg, #10b981 0%, #059669 100%);
        --warning-gradient: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        --danger-gradient: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        --info-gradient: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        --card-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        --hover-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }

    .premium-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: var(--card-shadow);
        transition: all 0.3s ease;
        border: 1px solid rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .premium-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--hover-shadow);
    }

    .stat-card {
        position: relative;
        padding: 1.5rem;
        height: 100%;
        display: flex;
        align-items: center;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-right: 1rem;
    }

    .pulse-text {
        animation: pulse-animation 1.5s infinite ease-in-out;
        display: inline-block;
    }
    @@keyframes pulse-animation {
        0% { opacity: 1; }
        50% { opacity: 0.5; transform: scale(1.05); }
        100% { opacity: 1; }
    }
</style>

<div class="tables-wrapper">
    <!-- Hero Section -->
    <div class="hero-section d-flex flex-column flex-md-row justify-content-between align-items-center px-4" style="text-align: left; margin-top: -1.5rem; margin-bottom: 2rem;">
        <div class="position-relative z-1 text-center text-md-start mb-3 mb-md-0">
            <h1 class="hero-title fw-bold mb-2 text-white"><i class="lni lni-grid-alt me-2"></i>Panel de Mesas</h1>
            <p class="mb-0 text-white-50 fs-5">Gestión de ocupación y cuentas abiertas en tiempo real.</p>
        </div>
        <div class="position-relative z-1 d-none d-md-block">
            <div class="breadcrumb-wrapper">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a asp-controller ="Home" asp-action="Index" class="text-white-50">Dashboard</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Mesas</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <!-- Header Actions -->
    <div class="premium-card mb-4 p-4">
        <div class="row align-items-center g-3">
            <div class="col-12 col-lg-4">
                <div class="d-flex align-items-center justify-content-center justify-content-lg-start">
                    <div class="avatar bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                        <i class="lni lni-restaurant fs-4"></i>
                    </div>
                    <div class="text-start">
                        <h6 class="mb-0">Control de Mesas</h6>
                        <p class="text-sm text-muted mb-0">Estado de Salón</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="d-flex justify-content-center gap-2">
                    <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 rounded-pill"><i class="lni lni-checkmark-circle me-1"></i>Mesa Libre</span>
                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning px-3 py-2 rounded-pill"><i class="lni lni-user me-1"></i>Mesa Ocupada</span>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 text-center text-lg-end">
                <button class="main-btn primary-btn btn-hover rounded-pill px-4" onclick="location.reload()">
                    <i class="lni lni-reload me-2"></i> Actualizar
                </button>
            </div>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="row g-4 mb-4">
        <div class="col-6 col-md-4 col-xl-2">
            <div class="premium-card stat-card p-3 p-md-4 flex-column flex-sm-row text-center text-sm-start">
                <div class="stat-icon bg-success bg-opacity-10 text-success mb-2 mb-sm-0 mx-auto mx-sm-0 me-sm-3">
                    <i class="lni lni-checkmark-circle"></i>
                </div>
                <div>
                    <h3 class="mb-0 fw-bold">@mesasLibres</h3>
                    <span class="text-sm text-muted">Libres</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="premium-card stat-card p-3 p-md-4 flex-column flex-sm-row text-center text-sm-start">
                <div class="stat-icon bg-warning bg-opacity-10 text-warning mb-2 mb-sm-0 mx-auto mx-sm-0 me-sm-3">
                    <i class="lni lni-user"></i>
                </div>
                <div>
                    <h3 class="mb-0 fw-bold">@mesasOcupadas</h3>
                    <span class="text-sm text-muted">Ocupadas</span>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null || TempData["Success"] != null)
    {
        <div class="mb-4">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert" style="border-left: 4px solid #10b981 !important;">
                    <div class="d-flex align-items-center">
                        <i class="lni lni-checkmark-circle fs-4 me-2"></i>
                        <div>@TempData["Success"]</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0" role="alert" style="border-left: 4px solid #ef4444 !important;">
                    <div class="d-flex align-items-center">
                        <i class="lni lni-warning fs-4 me-2"></i>
                        <div>@TempData["Error"]</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>
    }

    <div class="row g-4">
        @for (int i = 1; i <= totalMesas; i++)
        {
            var pedidoMesa = Model.FirstOrDefault(p => p.NumeroMesa == i);
            bool ocupada = pedidoMesa != null;

            <div class="col-6 col-md-4 col-lg-3">
                @if (ocupada)
                {
                    bool platosListos = pedidoMesa.Items.Any(item => item.Estado == PedidoEstado.Listo);
                    bool todosEntregados = pedidoMesa.Items.Any() && pedidoMesa.Items.All(item => item.Estado == PedidoEstado.Entregado);
                    string borderLeft = platosListos ? "#3b82f6" : (todosEntregados ? "#10b981" : "#f59e0b");
                    
                    <a href="@Url.Action("Editar", "Pedidos", new { id = pedidoMesa.Id_Venta })" class="text-decoration-none h-100 d-block">
                        <div class="premium-card h-100" style="border-left: 4px solid @borderLeft;">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div class="avatar bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm @(platosListos ? "bg-info text-info" : (todosEntregados ? "bg-success text-success" : "bg-warning text-warning"))" style="width: 48px; height: 48px;">
                                        @i
                                    </div>
                                    <span class="badge bg-light text-dark border rounded-pill">#@pedidoMesa.Id_Venta</span>
                                </div>
                                
                                <h6 class="mb-2 text-dark fw-bold">Mesa @i</h6>
                                <p class="mb-1 text-muted text-sm text-truncate"><i class="lni lni-user me-2"></i>@pedidoMesa.Cliente</p>
                                
                                @if(platosListos)
                                {
                                    <small class="text-info fw-bold pulse-text d-block mb-3"><i class="lni lni-bell me-1"></i>¡Comida Lista!</small>
                                }
                                else if(todosEntregados)
                                {
                                    <small class="text-success fw-bold d-block mb-3"><i class="lni lni-checkmark-circle me-1"></i>¡Comida Servida!</small>
                                }
                                else
                                {
                                    <small class="text-warning fw-bold d-block mb-3">En preparación...</small>
                                }

                                <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                                    <span class="text-muted text-sm">@pedidoMesa.Items.Sum(x => x.Cantidad) ítms</span>
                                    <h5 class="mb-0 fw-bold text-dark">@pedidoMesa.Total.ToString("C", numberFormat)</h5>
                                </div>
                            </div>
                        </div>
                    </a>
                }
                else
                {
                    <a href="@Url.Action("NuevaMesa", "Pedidos", new { numeroMesa = i })" class="text-decoration-none h-100 d-block">
                        <div class="premium-card h-100 bg-light bg-opacity-50" style="border-left: 4px solid #10b981;">
                            <div class="card-body p-4 d-flex flex-column align-items-center text-center">
                                <div class="avatar bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 56px; height: 56px;">
                                    <h3 class="mb-0 fw-bold">@i</h3>
                                </div>
                                <h6 class="text-secondary fw-bold mb-1">Mesa @i</h6>
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 mt-auto">LIBRE</span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>
