@using VentaFacil.web.Models.Dto
@model GenerarNominaDto

<div class="payroll-wrapper">
    <div class="hero-section d-flex flex-column flex-md-row justify-content-between align-items-center px-4 mb-4" style="margin-top: -1.5rem;">
        <div class="position-relative z-1 text-center text-md-start mb-3 mb-md-0">
            <h1 class="hero-title fw-bold mb-2 text-white"><i class="lni lni-wallet me-2"></i>Generar Nómina</h1>
            <p class="mb-0 text-white-50 fs-5">Cálculo y procesamiento de pagos.</p>
        </div>
        <div class="position-relative z-1 d-none d-md-block">
            <div class="breadcrumb-wrapper">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")" class="text-white-50">Inicio</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index","Planilla")" class="text-white-50">Planilla</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Generar Nómina</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

<div class="row">
    <div class="col-12">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible">
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                <i class="fas fa-check me-1"></i> @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible">
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                <strong><i class="fas fa-ban me-1"></i> Error:</strong> @TempData["Error"]
                @if (ViewBag.ErroresValidacion != null)
                {
                    <hr />
                    <ul class="mb-0">
                        @foreach (var error in ViewBag.ErroresValidacion as List<string>)
                        { <li><i class="lni lni-warning"></i> @error</li> }
                    </ul>
                }
            </div>
        }

        <div class="row justify-content-center mx-2">
            <div class="col-md-9 col-lg-7">
                <div class="premium-card p-4">
                    <div class="mb-4 d-flex align-items-center">
                        <div class="icon-box bg-primary bg-opacity-10 text-primary rounded-3 me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                            <i class="lni lni-cogs"></i>
                        </div>
                        <h5 class="fw-bold mb-0">Parámetros de Generación</h5>
                    </div>

                    @* Selector de período rápido *@
                    <div class="mb-4">
                        <label class="form-label text-xs fw-bold text-muted text-uppercase mb-2 ms-2">Período predefinido</label>
                        <div class="d-flex gap-2 flex-wrap">
                            <button type="button" id="btnSemanal" onclick="setPeriodo('Semanal')"
                                    class="main-btn primary-btn-outline btn-hover rounded-pill px-4 @(Model.TipoPeriodo=="Semanal"?"active":"")">
                                <i class="lni lni-calendar me-2"></i> Semanal
                            </button>
                            <button type="button" id="btnTrimestral" onclick="setPeriodo('Trimestral')"
                                    class="main-btn primary-btn-outline btn-hover rounded-pill px-4 @(Model.TipoPeriodo=="Trimestral"?"active":"")">
                                <i class="lni lni-library me-2"></i> Trimestral
                            </button>
                            <button type="button" id="btnPersonalizado" onclick="setPeriodo('Personalizado')"
                                    class="main-btn primary-btn-outline btn-hover rounded-pill px-4 @(Model.TipoPeriodo=="Personalizado"?"active":"")">
                                <i class="lni lni-control-panel me-2"></i> Personalizado
                            </button>
                        </div>
                    </div>

                    <form asp-controller="Planilla" asp-action="GenerarNomina" method="post" id="formGenerarNomina">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="TipoPeriodo" id="hidTipoPeriodo" />

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="FechaInicio" class="form-label">Fecha Inicio</label>
                                <input asp-for="FechaInicio" type="date" class="form-control" id="inputInicio" />
                                <span asp-validation-for="FechaInicio" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="FechaFinal" class="form-label">Fecha Final</label>
                                <input asp-for="FechaFinal" type="date" class="form-control" id="inputFin" />
                                <span asp-validation-for="FechaFinal" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Id_Usr" class="form-label">Colaborador</label>
                            <select asp-for="Id_Usr" class="form-select" asp-items="ViewBag.Usuarios">
                                <option value="">-- Todos los colaboradores --</option>
                            </select>
                            <span asp-validation-for="Id_Usr" class="text-danger"></span>
                        </div>

                        <div class="mb-3" id="periodoInfo">
                            <div class="alert alert-info mb-0 py-2">
                                <i class="fas fa-info-circle me-1"></i>
                                <span id="periodoDesc"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="IncluirSoloUsuariosActivos" class="form-check-input" type="checkbox" />
                                <label asp-for="IncluirSoloUsuariosActivos" class="form-check-label">
                                    Incluir solo colaboradores activos
                                </label>
                            </div>
                        </div>

                        <div class="d-grid gap-3 mt-4">
                            <button type="submit" class="main-btn success-btn btn-hover rounded-pill py-3">
                                <i class="lni lni-cogs me-2"></i> Generar Nómina
                            </button>
                            <a href="@Url.Action("Index","Planilla")" class="main-btn dark-btn-outline btn-hover rounded-pill py-3">
                                <i class="lni lni-arrow-left me-2"></i> Volver
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    // Calcula lunes de la semana actual
    function getMondayOfWeek(d) {
        d = d || new Date();
        var day = d.getDay(); // 0=dom
        var diff = (day === 0) ? -6 : 1 - day;
        var mon = new Date(d);
        mon.setDate(mon.getDate() + diff);
        return mon;
    }
    function toInputDate(d) {
        return d.toISOString().split('T')[0];
    }
    function getQuarterRange() {
        var now = new Date();
        var q = Math.floor(now.getMonth() / 3);
        var start = new Date(now.getFullYear(), q * 3, 1);
        var end   = new Date(now.getFullYear(), q * 3 + 3, 0);
        return { start, end };
    }

    window.setPeriodo = function(tipo) {
        document.getElementById('hidTipoPeriodo').value = tipo;
        var inicio = document.getElementById('inputInicio');
        var fin    = document.getElementById('inputFin');
        var desc   = document.getElementById('periodoDesc');
        var info   = document.getElementById('periodoInfo');

        document.querySelectorAll('.periodo-btn').forEach(b => b.classList.remove('active'));

        if (tipo === 'Semanal') {
            var lun = getMondayOfWeek();
            var dom = new Date(lun); dom.setDate(dom.getDate() + 6);
            inicio.value = toInputDate(lun);
            fin.value    = toInputDate(dom);
            desc.textContent = 'Semana del ' + lun.toLocaleDateString('es-CR') + ' al ' + dom.toLocaleDateString('es-CR');
            inicio.readOnly = true; fin.readOnly = true;
            document.getElementById('btnSemanal').classList.add('active');
        } else if (tipo === 'Trimestral') {
            var q = getQuarterRange();
            inicio.value = toInputDate(q.start);
            fin.value    = toInputDate(q.end);
            desc.textContent = 'Trimestre actual: ' + q.start.toLocaleDateString('es-CR') + ' al ' + q.end.toLocaleDateString('es-CR');
            inicio.readOnly = true; fin.readOnly = true;
            document.getElementById('btnTrimestral').classList.add('active');
        } else {
            inicio.readOnly = false; fin.readOnly = false;
            desc.textContent = 'Seleccione el rango de fechas manualmente.';
            document.getElementById('btnPersonalizado').classList.add('active');
        }
        info.style.display = 'block';
    };

    // Inicializar según el valor del modelo (viene del servidor)
    var tipoPeriodo = document.getElementById('hidTipoPeriodo').value || 'Semanal';
    setPeriodo(tipoPeriodo);
})();
</script>