@model VentaFacil.web.Models.Response.Caja.ListCajaResponse

@{
    ViewData["Title"] = "Caja";
    Layout = "_LayoutPlantilla";
    var cajaAbierta = Model.Cajas.FirstOrDefault(c => c.Estado == "Abierta" && c.Fecha_Apertura.Date == DateTime.Now.Date);
}

<style>
    .caja-badge {
        font-size: 0.75rem;
        padding: 5px 12px;
        border-radius: 50px;
        font-weight: 600;
    }
</style>

<div class="caja-wrapper">
    <!-- Hero Section -->
    <div class="hero-section d-flex flex-column flex-md-row justify-content-between align-items-center px-4" style="text-align: left; margin-top: -1.5rem; margin-bottom: 2rem;">
        <div class="position-relative z-1 text-center text-md-start mb-3 mb-md-0">
            <h1 class="hero-title fw-bold mb-2 text-white"><i class="lni lni-wallet me-2"></i>Administrar Caja</h1>
            <p class="mb-0 text-white-50 fs-5">Resumen de movimientos y control de efectivo.</p>
        </div>
        <div class="position-relative z-1 d-none d-md-block">
            <div class="breadcrumb-wrapper">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="#0" class="text-white-50">App</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Caja</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <!-- Header Actions -->
    <div class="mb-4">
        <div class="premium-card p-4">
            <div class="row align-items-center g-3">
                <div class="col-12 col-lg-4">
                    <div class="d-flex align-items-center">
                        <div class="avatar bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                            <i class="lni lni-wallet fs-4"></i>
                        </div>
                        <div class="text-start">
                            <h6 class="mb-0 fw-bold">Estado de Caja</h6>
                            <p class="text-sm text-muted mb-0">@(cajaAbierta != null ? "Sesión Activa" : "Cerrada")</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-8 text-center text-lg-end">
                    <div class="d-flex flex-wrap justify-content-center justify-content-lg-end gap-2">
                        @if (cajaAbierta == null)
                        {
                            <button type="button" class="main-btn primary-btn btn-hover rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#abrirCajaModal">
                                <i class="lni lni-plus me-2"></i> Abrir Caja
                            </button>
                        }
                        else
                        {
                            <a href="@Url.Action("GenerarArqueo", "Caja", new { idCaja = cajaAbierta.Id_Caja })" class="main-btn dark-btn-outline btn-hover rounded-pill px-4" target="_blank">
                                <i class="lni lni-printer me-2"></i> Arqueo
                            </a>
                            <button type="button" class="main-btn warning-btn btn-hover rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#retiroCajaModal">
                                <i class="lni lni-minus me-2"></i> Retiro
                            </button>
                            <button type="button" class="main-btn danger-btn btn-hover rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#cerrarCajaModal">
                                <i class="lni lni-lock me-2"></i> Cerrar Caja
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Grid -->
    @if (cajaAbierta != null)
    {
        <div class="row g-4 mb-4">
            <div class="col-6 col-md-4 col-xl-2">
                <div class="premium-card p-4 h-100 border-0 shadow-sm">
                    <div class="d-flex align-items-center mb-2">
                        <div class="icon-box bg-success bg-opacity-10 text-success rounded-3 me-2" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                            <i class="lni lni-money-location"></i>
                        </div>
                        <span class="text-xs fw-bold text-uppercase text-muted">Efectivo CRC</span>
                    </div>
                    <h4 class="mb-0 fw-bold">@((cajaAbierta.Monto ?? 0).ToString("C0", new System.Globalization.CultureInfo("es-CR")))</h4>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <div class="premium-card p-4 h-100 border-0 shadow-sm">
                    <div class="d-flex align-items-center mb-2">
                        <div class="icon-box bg-info bg-opacity-10 text-info rounded-3 me-2" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                            <i class="lni lni-dollar"></i>
                        </div>
                        <span class="text-xs fw-bold text-uppercase text-muted">Efectivo USD</span>
                    </div>
                    <h4 class="mb-0 fw-bold">$@((cajaAbierta.Monto_USD ?? 0).ToString("N2"))</h4>
                </div>
            </div>
        </div>
    }

    <div class="mb-5 animate-fade-in">
        <div class="premium-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h5 class="fw-bold mb-1"><i class="lni lni-timer me-2 text-primary"></i> Historial de Cajas</h5>
                    <p class="text-sm text-muted mb-0">Registro histórico de aperturas y cierres.</p>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table premium-table align-middle">
                    <thead>
                        <tr>
                            <th class="ps-4">Apertura / Cierre</th>
                            <th>Monto Inicial</th>
                            <th>Monto Actual</th>
                            <th>Dólares (Ini/Act)</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Cajas) {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex flex-column">
                                    <span class="fw-bold text-dark">@item.Fecha_Apertura.ToString("dd/MM/yyyy HH:mm")</span>
                                    <small class="text-muted">@(item.Fecha_Cierre?.ToString("dd/MM/yyyy HH:mm") ?? "Sesion Activa")</small>
                                </div>
                            </td>
                            <td>
                                <span class="fw-bold text-success">@item.Monto_Inicial.ToString("C0", new System.Globalization.CultureInfo("es-CR"))</span>
                            </td>
                            <td>
                                <span class="fw-bold text-success">@((item.Monto ?? 0).ToString("C0", new System.Globalization.CultureInfo("es-CR")))</span>
                            </td>
                            <td>
                                <div class="d-flex flex-column">
                                    <span class="text-info fw-bold">$@item.Monto_Inicial_USD.ToString("N2")</span>
                                    <small class="text-muted">$@((item.Monto_USD ?? 0).ToString("N2"))</small>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge @(item.Estado == "Abierta" ? "bg-success" : "bg-dark") bg-opacity-10 @(item.Estado == "Abierta" ? "text-success" : "text-dark") rounded-pill px-3 py-1" style="font-size: 0.75rem;">
                                    @item.Estado
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <button type="button" class="main-btn dark-btn-outline btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#retirosModal" data-caja-id="@item.Id_Caja">
                                    <i class="lni lni-eye me-1"></i> Retiros
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <!-- Paginación -->
            @if (Model.TotalPaginas > 1)
            {
                <nav aria-label="Navegación de cajas" class="mt-4">
                    <ul class="pagination justify-content-center gap-2">
                        <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                            <a class="page-link border-0 rounded-3 bg-light text-dark" href="@Url.Action("Listar", new { pagina = Model.PaginaActual - 1 })">
                                <i class="lni lni-chevron-left"></i>
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPaginas; i++)
                        {
                            <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                                <a class="page-link border-0 rounded-3 @(i == Model.PaginaActual ? "bg-primary text-white shadow-sm" : "bg-light text-dark")" href="@Url.Action("Listar", new { pagina = i })">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                            <a class="page-link border-0 rounded-3 bg-light text-dark" href="@Url.Action("Listar", new { pagina = Model.PaginaActual + 1 })">
                                <i class="lni lni-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<!-- Modal Abrir Caja -->
<div class="modal fade" id="abrirCajaModal" tabindex="-1" aria-labelledby="abrirCajaModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="abrirCajaModalLabel">Abrir Caja</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <form asp-action="Abrir" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label for="montoInicial" class="control-label fw-bold">Fondo Inicial Colones (¢)</label>
                <input type="number" step="0.01" min="0" name="montoInicial" class="form-control" required placeholder="0.00" />
            </div>
            <div class="form-group mb-3">
                <label for="montoInicialUSD" class="control-label fw-bold text-info">Fondo Inicial Dólares ($)</label>
                <input type="number" step="0.01" min="0" name="montoInicialUSD" value="0.00" class="form-control" required placeholder="0.00" />
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-primary">Abrir Caja</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Modal Cerrar Caja -->
<div class="modal fade" id="cerrarCajaModal" tabindex="-1" aria-labelledby="cerrarCajaModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="cerrarCajaModalLabel">Cierre de Caja</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-info py-2 mb-3 d-flex justify-content-between">
            <div>
                <strong>Sistema (CRC): </strong>
                <span class="fs-5 text-success fw-bold">@(((decimal)(cajaAbierta?.Monto ?? 0)).ToString("C", new System.Globalization.CultureInfo("es-CR")))</span>
            </div>
            <div>
                <strong>Sistema (USD): </strong>
                <span class="fs-5 text-info fw-bold">$@(((decimal)(cajaAbierta?.Monto_USD ?? 0)).ToString("N2"))</span>
            </div>
        </div>
        <form asp-action="CerrarConfirmado" method="post" id="formCerrarCaja">
            <input type="hidden" name="id" value="@cajaAbierta?.Id_Caja" />
            <input type="hidden" id="montoEsperadoCierre" value="@(cajaAbierta?.Monto ?? 0)" />
            <input type="hidden" id="montoEsperadoCierreUSD" value="@(cajaAbierta?.Monto_USD ?? 0)" />
            
            <div class="row">
                <div class="col-md-6 form-group mb-3">
                    <label for="montoFisico" class="control-label fw-bold">Físico Colones (¢)</label>
                    <input type="number" step="0.01" min="0" id="montoFisico" name="montoFisico" class="form-control" required placeholder="Dinero real ¢..." />
                </div>
                <div class="col-md-6 form-group mb-3">
                    <label for="montoFisicoUSD" class="control-label fw-bold text-info">Físico Dólares ($)</label>
                    <input type="number" step="0.01" min="0" id="montoFisicoUSD" name="montoFisicoUSD" class="form-control" required placeholder="Dinero real $..." />
                </div>
            </div>

            <div id="discrepanciaContainer" style="display:none;" class="p-3 mb-3 rounded">
                <p class="mb-1 fw-bold" id="discrepanciaTexto"></p>
                <p class="mb-1 fw-bold" id="discrepanciaTextoUSD"></p>
                <div class="form-group mt-2">
                    <label for="justificacion" class="control-label text-danger">Justificación de la Diferencia</label>
                    <textarea id="justificacion" name="justificacion" class="form-control" rows="2" placeholder="Explique la causa del sobrante o faltante..."></textarea>
                </div>
            </div>

            <div class="modal-footer">
                <button type="submit" class="btn btn-danger">Confirmar cierre</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Modal Retiro de Caja -->
<div class="modal fade" id="retiroCajaModal" tabindex="-1" aria-labelledby="retiroCajaModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="retiroCajaModalLabel">Retiro de Caja</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <form asp-action="Retiro" method="post">
            <input type="hidden" name="id" value="@cajaAbierta?.Id_Caja" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label for="monto" class="control-label fw-bold">Monto a retirar (¢)</label>
                <input type="number" step="0.01" min="0.01" name="monto" class="form-control" required placeholder="0.00" />
            </div>
            <div class="form-group mb-3">
                <label for="motivo" class="control-label fw-bold">Motivo o Justificación</label>
                <input type="text" name="motivo" class="form-control" required placeholder="Ej: Pago a proveedores, compra de insumos..." />
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-warning">Retirar</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Modal Ver Retiros -->
<div class="modal fade" id="retirosModal" tabindex="-1" aria-labelledby="retirosModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="retirosModalLabel">Retiros de Caja</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="retirosModalBody">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $('#retirosModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var cajaId = button.data('caja-id');
            var modal = $(this);
            modal.find('.modal-body').load('/Caja/Retiros/' + cajaId);
        });

        function calcularDiscrepancias() {
            var esperadoCRC = parseFloat($('#montoEsperadoCierre').val()) || 0;
            var fisicoCRC = parseFloat($('#montoFisico').val()) || 0;
            var difCRC = fisicoCRC - esperadoCRC;

            var esperadoUSD = parseFloat($('#montoEsperadoCierreUSD').val()) || 0;
            var fisicoUSD = parseFloat($('#montoFisicoUSD').val()) || 0;
            var difUSD = fisicoUSD - esperadoUSD;
            
            var container = $('#discrepanciaContainer');
            var spanTextCRC = $('#discrepanciaTexto');
            var spanTextUSD = $('#discrepanciaTextoUSD');
            var txtJustif = $('#justificacion');

            var hasDiffCRC = Math.abs(difCRC) > 0.01;
            var hasDiffUSD = Math.abs(difUSD) > 0.01;

            if (hasDiffCRC || hasDiffUSD) {
                container.show();
                txtJustif.prop('required', true);
                
                // Color de fondo general
                if (difCRC >= 0 && difUSD >= 0) {
                    container.css('background-color', '#d1e7dd');
                } else {
                    container.css('background-color', '#f8d7da');
                }

                if(hasDiffCRC) {
                    if (difCRC > 0) {
                        spanTextCRC.html('CRC Sobran: <span class="text-success">' + difCRC.toLocaleString('es-CR', {style:'currency', currency:'CRC'}) + '</span>').show();
                    } else {
                        spanTextCRC.html('CRC Faltan: <span class="text-danger">' + Math.abs(difCRC).toLocaleString('es-CR', {style:'currency', currency:'CRC'}) + '</span>').show();
                    }
                } else {
                    spanTextCRC.hide();
                }

                if(hasDiffUSD) {
                    if (difUSD > 0) {
                        spanTextUSD.html('USD Sobran: <span class="text-success">$' + difUSD.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + '</span>').show();
                    } else {
                        spanTextUSD.html('USD Faltan: <span class="text-danger">$' + Math.abs(difUSD).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + '</span>').show();
                    }
                } else {
                    spanTextUSD.hide();
                }

            } else {
                container.hide();
                txtJustif.prop('required', false);
                txtJustif.val('');
            }
        }

        $('#montoFisico, #montoFisicoUSD').on('input', calcularDiscrepancias);
    </script>
}