@model VentaFacil.web.Models.Response.Factura.ListFacturaResponse

@{
    ViewData["Title"] = "Historial de Facturas";
    Layout = "_LayoutPlantilla";

    var totalFacturas = Model.TotalRegistros;
    var totalMonto = Model.TotalMonto;
    var anuladasCount = Model.TotalAnuladas;

    var cultureCR = System.Globalization.CultureInfo.GetCultureInfo("es-CR");
    var numberFormat = (System.Globalization.NumberFormatInfo)cultureCR.NumberFormat.Clone();
    numberFormat.CurrencySymbol = "¢";
}

<div class="billing-wrapper">
    <!-- Hero Section -->
    <div class="hero-section d-flex flex-column flex-md-row justify-content-between align-items-center px-4" style="text-align: left; margin-top: -1.5rem; margin-bottom: 2rem;">
        <div class="position-relative z-1 text-center text-md-start mb-3 mb-md-0">
            <h1 class="hero-title fw-bold mb-2 text-white"><i class="lni lni-library me-2"></i>Historial de Facturas</h1>
            <p class="mb-0 text-white-50 fs-5">Consulta y gestión de transacciones históricas.</p>
        </div>
        <div class="position-relative z-1 d-none d-md-block">
            <div class="breadcrumb-wrapper">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"  class="text-white-50">Dashboard</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Facturación</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <!-- Filtros y Acciones -->
    <div class="mb-4">
        <div class="premium-card p-4">
            <div class="row align-items-center g-3 mb-4">
                <div class="col-12 col-md-6">
                    <div class="d-flex align-items-center">
                        <div class="avatar bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                            <i class="lni lni-funnel fs-4"></i>
                        </div>
                        <div class="text-start">
                            <h6 class="mb-0 fw-bold">Filtros Avanzados</h6>
                            <p class="text-sm text-muted mb-0">Refina los resultados del historial</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 text-md-end">
                    <a href="@Url.Action("Index", "Facturacion")" class="main-btn dark-btn-outline btn-hover rounded-pill px-4 me-2">
                        <i class="lni lni-reload me-2"></i> Limpiar
                    </a>
                </div>
            </div>
            
            <form method="get" action="@Url.Action("Index", "Facturacion")">
                <div class="row g-3">
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="form-group">
                            <label class="form-label text-xs fw-bold text-muted text-uppercase mb-1 ms-2">Fecha Inicio</label>
                            <input type="date" class="form-control rounded-pill bg-light border-0 px-3 py-2" name="fechaInicio" value="@Model.FechaInicio?.ToString("yyyy-MM-dd")">
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="form-group">
                            <label class="form-label text-xs fw-bold text-muted text-uppercase mb-1 ms-2">Fecha Fin</label>
                            <input type="date" class="form-control rounded-pill bg-light border-0 px-3 py-2" name="fechaFin" value="@Model.FechaFin?.ToString("yyyy-MM-dd")">
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="form-group">
                            <label class="form-label text-xs fw-bold text-muted text-uppercase mb-1 ms-2">N° Factura</label>
                            <input type="number" class="form-control rounded-pill bg-light border-0 px-3 py-2" name="numeroFactura" value="@Model.NumeroFactura" placeholder="Ej: 123">
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="form-group">
                            <label class="form-label text-xs fw-bold text-muted text-uppercase mb-1 ms-2">Cliente</label>
                            <div class="input-group">
                                <input type="text" class="form-control rounded-pill bg-light border-0 px-3 py-2" name="cliente" value="@Model.Cliente" placeholder="Nombre...">
                                <button type="submit" class="main-btn primary-btn btn-hover rounded-pill px-4 ms-2 py-2">Buscar</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="row g-4 mb-4">
        <div class="col-6 col-md-4 col-xl-2">
            <div class="premium-card p-4 h-100 border-0 shadow-sm">
                <div class="d-flex align-items-center mb-2">
                    <div class="icon-box bg-primary bg-opacity-10 text-primary rounded-3 me-2" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                        <i class="lni lni-files"></i>
                    </div>
                    <span class="text-xs fw-bold text-uppercase text-muted">Facturas</span>
                </div>
                <h4 class="mb-0 fw-bold">@totalFacturas</h4>
            </div>
        </div>
        <div class="col-12 col-md-4 col-xl-3">
            <div class="premium-card p-4 h-100 border-0 shadow-sm">
                <div class="d-flex align-items-center mb-2">
                    <div class="icon-box bg-success bg-opacity-10 text-success rounded-3 me-2" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                        <i class="lni lni-coin"></i>
                    </div>
                    <span class="text-xs fw-bold text-uppercase text-muted">Monto Consultas</span>
                </div>
                <h4 class="mb-0 fw-bold">@totalMonto.ToString("C0", numberFormat)</h4>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="premium-card p-4 h-100 border-0 shadow-sm">
                <div class="d-flex align-items-center mb-2">
                    <div class="icon-box bg-danger bg-opacity-10 text-danger rounded-3 me-2" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                        <i class="lni lni-ban"></i>
                    </div>
                    <span class="text-xs fw-bold text-uppercase text-muted">Anuladas</span>
                </div>
                <h4 class="mb-0 fw-bold">@anuladasCount</h4>
            </div>
        </div>
    </div>

    <!-- Invoices Table -->
    <div class="mb-5 animate-fade-in">
        <div class="premium-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
                <div>
                    <h5 class="fw-bold mb-1"><i class="lni lni-library me-2 text-primary"></i> Resultados</h5>
                    <p class="text-sm text-muted mb-0">Listado de facturas encontradas (Página @Model.PaginaActual de @Model.TotalPaginas)</p>
                </div>
                <form method="get" action="@Url.Action("Index", "Facturacion")" id="facturacionPaginationForm" class="d-flex align-items-center gap-2 mt-2 mt-md-0">
                    <input type="hidden" name="fechaInicio" value="@Model.FechaInicio?.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="fechaFin" value="@Model.FechaFin?.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="numeroFactura" value="@Model.NumeroFactura" />
                    <input type="hidden" name="cliente" value="@Model.Cliente" />
                    
                    <label class="text-sm text-muted mb-0 text-nowrap">Registros por página:</label>
                    <select name="cantidadPorPagina" class="form-select form-select-sm rounded-pill bg-light border-0" style="width: 80px;" onchange="this.form.submit();">
                        <option value="10" selected="@(Model.CantidadPorPagina == 10)">10</option>
                        <option value="20" selected="@(Model.CantidadPorPagina == 20)">20</option>
                        <option value="50" selected="@(Model.CantidadPorPagina == 50)">50</option>
                        <option value="100" selected="@(Model.CantidadPorPagina == 100)">100</option>
                    </select>
                </form>
            </div>

            @if (Model.Facturas != null && Model.Facturas.Any())
            {
                <div class="table-responsive">
                    <table class="table premium-table align-middle">
                        <thead>
                            <tr>
                                <th class="ps-4">N° Factura</th>
                                <th>Fecha</th>
                                <th>Cliente</th>
                                <th class="text-end">Total</th>
                                <th class="text-center">Estado</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var factura in Model.Facturas)
                            {
                                <tr>
                                    <td class="ps-4"><span class="fw-bold text-dark">#@factura.NumeroFactura</span></td>
                                    <td>
                                        <span class="text-dark fw-bold">@factura.FechaEmision.ToString("dd/MM/yyyy")</span>
                                        <br/><small class="text-muted">@factura.FechaEmision.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-light rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                                <i class="lni lni-user text-muted"></i>
                                            </div>
                                            <span class="fw-medium">@factura.Cliente</span>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <div class="fw-bold text-dark">@factura.Total.ToString("C0", numberFormat)</div>
                                        @if (factura.EstadoFactura == VentaFacil.web.Models.Enum.EstadoFactura.Pendiente)
                                        {
                                            <small class="text-success fw-bold d-block">Pagado: @factura.MontoPagado.ToString("C0", numberFormat)</small>
                                            <small class="text-danger fw-bold d-block">Saldo: @((factura.Total - factura.MontoPagado).ToString("C0", numberFormat))</small>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (factura.EstadoFactura == VentaFacil.web.Models.Enum.EstadoFactura.Activa)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Activa</span>
                                        }
                                        else if (factura.EstadoFactura == VentaFacil.web.Models.Enum.EstadoFactura.Anulada)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3">Anulada</span>
                                        }
                                        else if (factura.EstadoFactura == VentaFacil.web.Models.Enum.EstadoFactura.NotaCredito)
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3">Nota de Crédito</span>
                                        }
                                        else if (factura.EstadoFactura == VentaFacil.web.Models.Enum.EstadoFactura.Pendiente)
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3">Pendiente</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a href="@Url.Action("DetalleFactura", "Facturacion", new { facturaId = factura.Id_Factura })" 
                                                class="btn btn-sm btn-white text-info rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: white;" title="Ver Detalle">
                                                <i class="lni lni-eye"></i>
                                            </a>
                                            <a href="@Url.Action("DescargarFactura", "Facturacion", new { facturaId = factura.Id_Factura, esCopia = true })" 
                                                class="btn btn-sm btn-white text-secondary rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: white;" title="Imprimir PDF" target="_blank">
                                                <i class="lni lni-printer"></i>
                                            </a>
                                            
                                            @if (factura.EstadoFactura == VentaFacil.web.Models.Enum.EstadoFactura.Activa)
                                            {
                                                <button type="button" class="btn btn-sm btn-white text-danger rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: white;" title="Anular Factura" onclick="abrirModalAnular(@factura.Id_Factura, '@factura.NumeroFactura')">
                                                    <i class="lni lni-ban"></i>
                                                </button>
                                                
                                                <button type="button" class="btn btn-sm btn-white text-warning rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: white;" title="Devolución" onclick="abrirModalDevolucion(@factura.Id_Factura, '@factura.NumeroFactura')">
                                                    <i class="lni lni-reload"></i>
                                                </button>
                                            }
                                            else if (factura.EstadoFactura == VentaFacil.web.Models.Enum.EstadoFactura.Pendiente)
                                            {
                                                <button type="button" class="btn btn-sm btn-white text-success rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: white;" title="Registrar Abono" onclick="abrirModalAbono(@factura.Id_Factura, '@factura.NumeroFactura', @Math.Max(0, factura.Total - factura.MontoPagado).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))">
                                                    <i class="lni lni-coin"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Paginación -->
                @if (Model.TotalPaginas > 1)
                {
                    <nav aria-label="Navegación de facturas" class="mt-4">
                        <ul class="pagination justify-content-center gap-2">
                            <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                                <a class="page-link border-0 rounded-3 bg-light text-dark" href="@Url.Action("Index", new { pagina = Model.PaginaActual - 1, cantidadPorPagina = Model.CantidadPorPagina, fechaInicio = Model.FechaInicio?.ToString("yyyy-MM-dd"), fechaFin = Model.FechaFin?.ToString("yyyy-MM-dd"), numeroFactura = Model.NumeroFactura, cliente = Model.Cliente })">
                                    <i class="lni lni-chevron-left"></i>
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPaginas; i++)
                            {
                                <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                                    <a class="page-link border-0 rounded-3 @(i == Model.PaginaActual ? "bg-primary text-white shadow-sm" : "bg-light text-dark")" href="@Url.Action("Index", new { pagina = i, cantidadPorPagina = Model.CantidadPorPagina, fechaInicio = Model.FechaInicio?.ToString("yyyy-MM-dd"), fechaFin = Model.FechaFin?.ToString("yyyy-MM-dd"), numeroFactura = Model.NumeroFactura, cliente = Model.Cliente })">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                                <a class="page-link border-0 rounded-3 bg-light text-dark" href="@Url.Action("Index", new { pagina = Model.PaginaActual + 1, cantidadPorPagina = Model.CantidadPorPagina, fechaInicio = Model.FechaInicio?.ToString("yyyy-MM-dd"), fechaFin = Model.FechaFin?.ToString("yyyy-MM-dd"), numeroFactura = Model.NumeroFactura, cliente = Model.Cliente })">
                                    <i class="lni lni-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="empty-state text-center py-5">
                    <div class="mb-3">
                        <i class="lni lni-search fs-1 text-muted"></i>
                    </div>
                    <h5 class="fw-bold text-muted">No se encontraron facturas</h5>
                    <p class="text-muted text-sm">Intenta ajustar los filtros de búsqueda.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Anular Factura -->
<div class="modal fade" id="modalAnular" tabindex="-1" role="dialog" aria-labelledby="modalAnularLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-danger" id="modalAnularLabel">Anular Factura</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formAnular" method="post" action="@Url.Action("Anular", "Facturacion")">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <input type="hidden" id="anularFacturaId" name="facturaId" />
                    <div class="text-center mb-4">
                        <div class="avatar-lg bg-danger bg-opacity-10 text-danger rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                            <i class="lni lni-warning fs-2"></i>
                        </div>
                        <p class="text-muted">¿Está seguro que desea anular la factura <strong id="anularNumeroFactura" class="text-dark"></strong>? Esta acción es irreversible.</p>
                    </div>
                    <div class="form-group">
                        <label for="justificacion" class="form-label fw-bold text-sm text-muted">Justificación</label>
                        <textarea class="form-control" id="justificacion" name="justificacion" rows="3" required placeholder="Ingrese el motivo de la anulación..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">Anular Factura</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Devolución -->
<div class="modal fade" id="modalDevolucion" tabindex="-1" role="dialog" aria-labelledby="modalDevolucionLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold" id="modalDevolucionLabel">Registrar Devolución</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div class="text-center">
                    <div class="avatar-lg bg-warning bg-opacity-10 text-warning rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <i class="lni lni-reload fs-2"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Devolución para Factura <span id="devolucionNumeroFactura"></span></h6>
                    <p class="text-muted text-sm mb-4">Para procesar una devolución parcial o total, debes ir al detalle de la factura.</p>
                    <a id="btnIrADevolucion" href="#" class="btn btn-primary rounded-pill px-4 w-100">
                        Ir al Detalle
                        <i class="lni lni-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Registrar Abono -->
<div class="modal fade" id="modalAbono" tabindex="-1" role="dialog" aria-labelledby="modalAbonoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-success" id="modalAbonoLabel">Registrar Abono</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formAbono" method="post" action="@Url.Action("RegistrarAbono", "Facturacion")">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <input type="hidden" id="abonoFacturaId" name="facturaId" />
                    
                    <div class="text-center mb-4">
                        <div class="avatar-lg bg-success bg-opacity-10 text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                            <i class="lni lni-coin fs-2"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-2">Factura <span id="abonoNumeroFactura"></span></h6>
                        <p class="text-danger fw-bold fs-5 mb-0">Saldo Pendiente: ¢<span id="abonoSaldoPendiente"></span></p>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="metodoPagoAbono" class="form-label fw-bold text-sm text-muted">Método de Pago</label>
                            <select class="form-select" id="metodoPagoAbono" name="metodoPagoAbono" required>
                                <option value="Efectivo">Efectivo</option>
                                <option value="Tarjeta">Tarjeta</option>
                                <option value="Transferencia">Transferencia</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="montoAbono" class="form-label fw-bold text-sm text-muted">Monto (¢)</label>
                            <input type="number" class="form-control" id="montoAbono" name="montoAbono" step="0.01" min="0.01" required placeholder="0.00" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4">Registrar Abono</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModalAnular(id, numero) {
            document.getElementById('anularFacturaId').value = id;
            document.getElementById('anularNumeroFactura').textContent = '#' + numero;
            var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalAnular'));
            modal.show();
        }

        function abrirModalDevolucion(id, numero) {
            document.getElementById('devolucionNumeroFactura').textContent = '#' + numero;
            var url = '@Url.Action("DetalleFactura", "Facturacion")' + '?facturaId=' + id;
            document.getElementById('btnIrADevolucion').setAttribute('href', url);
            var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalDevolucion'));
            modal.show();
        }

        function abrirModalAbono(id, numero, saldo) {
            document.getElementById('abonoFacturaId').value = id;
            document.getElementById('abonoNumeroFactura').textContent = '#' + numero;
            var saldoNum = parseFloat(saldo);
            document.getElementById('abonoSaldoPendiente').textContent = saldoNum.toLocaleString('es-CR', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            document.getElementById('montoAbono').value = saldoNum.toFixed(2);
            document.getElementById('montoAbono').setAttribute('max', saldoNum.toFixed(2));
            var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalAbono'));
            modal.show();
        }
    </script>
}
