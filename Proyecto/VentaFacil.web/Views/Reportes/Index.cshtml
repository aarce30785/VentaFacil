@{
    ViewData["Title"] = "Reportes";
    Layout = "_LayoutPlantilla";
}

<div class="reports-wrapper">
    <!-- Hero Section -->
    <div class="hero-section d-flex flex-column flex-md-row justify-content-between align-items-center px-4" style="text-align: left; margin-top: -1.5rem; margin-bottom: 2rem;">
        <div class="position-relative z-1 text-center text-md-start mb-3 mb-md-0">
            <h1 class="hero-title fw-bold mb-2 text-white"><i class="lni lni-bar-chart me-2"></i>Módulo de Reportes</h1>
            <p class="mb-0 text-white-50 fs-5">Genera información histórica de movimientos y ventas.</p>
        </div>
        <div class="position-relative z-1 d-none d-md-block">
            <div class="breadcrumb-wrapper">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="#0" class="text-white-50">App</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Reportes</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible bg-danger text-white border-0 fade show" role="alert">
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            <strong>Error:</strong> @TempData["Error"]
        </div>
    }

    <div class="row g-4">
        <!-- Reporte Ventas Diarias -->
        <div class="col-md-6">
            <div class="premium-card h-100 p-4">
                <div class="d-flex align-items-center mb-4">
                    <div class="avatar bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                        <i class="lni lni-calendar fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark mb-0">Ventas Diarias</h4>
                        <p class="text-sm text-muted mb-0">Resumen de ventas por fecha específica</p>
                    </div>
                </div>
                
                <form asp-action="VentasDiarias" asp-controller="Reportes" method="post" target="_blank">
                    <div class="mb-4">
                        <label class="form-label fw-bold text-muted text-sm ps-2">Seleccionar Fecha</label>
                        <input type="date" name="fecha" class="form-control rounded-pill bg-light border-0 px-3 py-2" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="main-btn primary-btn btn-hover rounded-pill py-2">
                            <i class="lni lni-download me-2"></i> Generar PDF
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Reporte Personalizado -->
        <div class="col-md-6">
            <div class="premium-card h-100 p-4">
                <div class="d-flex align-items-center mb-4">
                    <div class="avatar bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                        <i class="lni lni-funnel fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark mb-0">Reporte Personalizado</h4>
                        <p class="text-sm text-muted mb-0">Filtros avanzados y exportación Excel</p>
                    </div>
                </div>
                
                <form asp-action="ReportePersonalizado" asp-controller="Reportes" method="post" target="_blank">
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted text-sm ps-2">Fecha Inicio</label>
                            <input type="date" name="fechaInicio" class="form-control rounded-pill bg-light border-0 px-3 py-2" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted text-sm ps-2">Fecha Fin</label>
                            <input type="date" name="fechaFin" class="form-control rounded-pill bg-light border-0 px-3 py-2" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold text-muted text-sm ps-2">Cajero / Usuario (Opcional)</label>
                            <select name="idCajero" class="form-select rounded-pill bg-light border-0 px-3 py-2" asp-items="ViewBag.Cajeros">
                                <option value="">-- Todos los cajeros --</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="main-btn success-btn btn-hover rounded-pill py-2">
                            <i class="lni lni-empty-file me-2"></i> Exportar a Excel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
