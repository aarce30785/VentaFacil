@{
    ViewData["Title"] = "Gestión de Planilla";
    Layout = "_LayoutPlantilla";
}

<div class="planilla-wrapper">
    <!-- Hero Section -->
    <div class="hero-section d-flex flex-column flex-md-row justify-content-between align-items-center px-4" style="text-align: left; margin-top: -1.5rem; margin-bottom: 2rem;">
        <div class="position-relative z-1 text-center text-md-start mb-3 mb-md-0">
            <h1 class="hero-title fw-bold mb-2 text-white"><i class="lni lni-agenda me-2"></i>Gestión de Planilla</h1>
            <p class="mb-0 text-white-50 fs-5">Control centralizado de nómina y personal.</p>
        </div>
        <div class="position-relative z-1 d-none d-md-block">
            <div class="breadcrumb-wrapper">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="#0" class="text-white-50">App</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Planilla</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <!-- Menú Principal -->
    <div class="row g-4 mb-5">
        <div class="col-12">
                <div class="d-flex align-items-center mb-4">
                    <div class="avatar-sm bg-primary bg-opacity-10 text-primary rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                        <i class="lni lni-sun"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Gestión Diaria</h5>
                </div>
            </div>
            
            <!-- Registro Horas -->
            <div class="col-md-6 col-xl-3">
                <a asp-controller="Planilla" asp-action="RegistrarHoras" class="text-decoration-none h-100 d-block">
                    <div class="premium-card p-4 text-center h-100 transition-all">
                        <div class="icon-lg bg-primary bg-opacity-10 text-primary rounded-4 mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2.5rem;">
                            <i class="lni lni-timer"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">Registro de Jornada</h5>
                        <p class="text-muted text-sm mb-0">Control de asistencia y horas trabajadas</p>
                    </div>
                </a>
            </div>

            <!-- Extras y Bonos -->
            <div class="col-md-6 col-xl-3">
                <a asp-controller="Planilla" asp-action="RegistrarExtrasBonos" class="text-decoration-none h-100 d-block">
                    <div class="premium-card p-4 text-center h-100 transition-all">
                        <div class="icon-lg bg-warning bg-opacity-10 text-warning rounded-4 mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2.5rem;">
                            <i class="lni lni-star"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">Extras y Bonificaciones</h5>
                        <p class="text-muted text-sm mb-0">Gestión de horas extras e incentivos</p>
                    </div>
                </a>
            </div>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-12">
                <div class="d-flex align-items-center mb-4">
                    <div class="avatar-sm bg-success bg-opacity-10 text-success rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                        <i class="lni lni-calendar"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Gestión Mensual</h5>
                </div>
            </div>

            <!-- Generar Nómina -->
            <div class="col-md-6 col-xl-3">
                <a asp-controller="Planilla" asp-action="GenerarNomina" class="text-decoration-none h-100 d-block">
                    <div class="premium-card p-4 text-center h-100 transition-all">
                        <div class="icon-lg bg-success bg-opacity-10 text-success rounded-4 mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2.5rem;">
                            <i class="lni lni-wallet"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">Generar Nómina</h5>
                        <p class="text-muted text-sm mb-0">Cálculo y procesamiento de pagos</p>
                    </div>
                </a>
            </div>

            <!-- Historial -->
            <div class="col-md-6 col-xl-3">
                <a asp-controller="Planilla" asp-action="Consultar" class="text-decoration-none h-100 d-block">
                    <div class="premium-card p-4 text-center h-100 transition-all">
                        <div class="icon-lg bg-info bg-opacity-10 text-info rounded-4 mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2.5rem;">
                            <i class="lni lni-agenda"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">Historial de Nóminas</h5>
                        <p class="text-muted text-sm mb-0">Consulta y reportes de pagos anteriores</p>
                    </div>
                </a>
            </div>
        </div>

        <!-- Configuración -->
        <div class="row g-4 mb-5">
            <div class="col-12">
                <div class="d-flex align-items-center mb-4">
                    <div class="avatar-sm bg-secondary bg-opacity-10 text-secondary rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                        <i class="lni lni-cog"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Configuración</h5>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <a asp-controller="ConfiguracionPlanilla" asp-action="Index" class="text-decoration-none h-100 d-block">
                    <div class="premium-card p-4 text-center h-100 transition-all">
                        <div class="icon-lg bg-secondary bg-opacity-10 text-secondary rounded-4 mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2.5rem;">
                            <i class="lni lni-cog"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">Configuración</h5>
                        <p class="text-muted text-sm mb-0">Tarifas por hora y deducciones</p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>
