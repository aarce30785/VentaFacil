@model VentaFacil.web.Models.Dto.PedidoDto
@using VentaFacil.web.Models.Enum

@{
    Layout = "_LayoutPlantilla";
    ViewData["Title"] = $"Editar Pedido #{Model.Id_Venta}";
    bool editable = !Model.TieneFactura() && Model.Estado != PedidoEstado.Cancelado;

    var cultureCR = new System.Globalization.CultureInfo("es-CR");
    var numberFormat = (System.Globalization.NumberFormatInfo)cultureCR.NumberFormat.Clone();
    numberFormat.CurrencySymbol = "¢";
}



<div class="edit-wrapper">
    <div class="pt-30">
        <!-- Header -->
        <div class="hero-section d-flex justify-content-between align-items-center px-4" style="text-align: left; margin-top: -1.5rem; margin-bottom: 2rem;">
            <div class="position-relative z-1">
                <h1 class="hero-title fw-bold mb-2 text-white"><i class="lni lni-pencil-alt me-2"></i>Editar Pedido <span class="text-warning">#@Model.Id_Venta</span></h1>
                <p class="mb-0 text-white-50 fs-5">Modifica los detalles del pedido seleccionado.</p>
            </div>
            <div class="position-relative z-1 d-none d-md-block">
                <div class="breadcrumb-wrapper">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a asp-action="Index" class="text-white-50">Pedidos</a></li>
                            <li class="breadcrumb-item active text-white" aria-current="page">Editar #@Model.Id_Venta</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>

        <!-- Alertas -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style="border-left: 4px solid #10b981 !important;">
                <i class="lni lni-checkmark-circle me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style="border-left: 4px solid #ef4444 !important;">
                <i class="lni lni-warning me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Status Bar -->
        <div class="premium-card mb-4">
            <div class="card-body-custom d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar bg-light rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="lni lni-calendar text-muted fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-0 text-sm">Fecha de Creación</p>
                        <h6 class="mb-0">@Model.Fecha.ToString("dd MMM yyyy, HH:mm")</h6>
                    </div>
                </div>
                
                <span class="status-badge-lg @GetBadgeClass(Model.Estado)">
                    <i class="lni lni-flag"></i> @GetEstadoText(Model.Estado)
                </span>
            </div>
        </div>

        @if (!editable)
        {
            <div class="alert alert-warning shadow-sm border-0 mb-4">
                <div class="d-flex align-items-center">
                    <i class="lni lni-lock fs-4 me-3"></i>
                    <div>
                        <h6 class="alert-heading mb-1">Modo de Solo Lectura</h6>
                        <p class="mb-0 text-sm">Este pedido no se puede editar porque se encuentra en estado <strong>@GetEstadoText(Model.Estado)</strong>.</p>
                        
                        @if (Model.Estado == PedidoEstado.Pendiente)
                        {
                            <form method="post" asp-action="ProcederAlPago" class="mt-2">
                                <input type="hidden" name="pedidoId" value="@Model.Id_Venta" />
                                <button type="submit" class="btn btn-success btn-sm rounded-pill px-3">
                                    <i class="lni lni-credit-card me-1"></i> Ir a Pagar
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="row g-4">
            <!-- Columna Izquierda: Info Cliente y Acciones -->
            <div class="col-lg-4">
                <div class="premium-card mb-4">
                    <div class="card-header-custom">
                        <h5 class="mb-0 fw-bold">👤 Cliente & Detalles</h5>
                    </div>
                    <div class="card-body-custom">
                        <form method="post" asp-action="ActualizarCliente" class="mb-4">
                            <input type="hidden" name="pedidoId" value="@Model.Id_Venta" />
                            <label class="form-label fw-bold text-muted text-sm text-uppercase">Nombre del Cliente</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="lni lni-user"></i></span>
                                <input type="text" name="cliente" value="@Model.Cliente" class="form-control border-start-0 ps-0" placeholder="Ej. Juan Pérez" @(!editable ? "disabled" : "") required />
                                @if (editable) { <button class="btn btn-outline-primary" type="submit">Ok</button> }
                            </div>
                        </form>

                        <form method="post" asp-action="ActualizarModalidad">
                            <input type="hidden" name="pedidoId" value="@Model.Id_Venta" />
                            <label class="form-label fw-bold text-muted text-sm text-uppercase">Modalidad</label>
                            <select name="modalidad" class="form-select mb-3" @(!editable ? "disabled" : "") onchange="this.form.submit()">
                                <option value="0" selected="@(Model.Modalidad == ModalidadPedido.ParaLlevar)">📦 Para Llevar</option>
                                <option value="1" selected="@(Model.Modalidad == ModalidadPedido.EnMesa)">🍽️ En Mesa</option>
                            </select>

                            @if (Model.Modalidad == ModalidadPedido.EnMesa)
                            {
                                <label class="form-label fw-bold text-muted text-sm text-uppercase">Número de Mesa</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="lni lni-grid-alt"></i></span>
                                    <select name="numeroMesa" class="form-select border-start-0 ps-0" @(!editable ? "disabled" : "") onchange="this.form.submit()">
                                        <option value="">Seleccione una mesa...</option>
                                        @{
                                            int totalMesas = ViewBag.TotalMesas as int? ?? 20;
                                            var mesasOcupadas = ViewBag.MesasOcupadas as List<int> ?? new List<int>();
                                        }
                                        @for (int i = 1; i <= totalMesas; i++)
                                        {
                                            bool estaOcupada = mesasOcupadas.Contains(i) && Model.NumeroMesa != i;
                                            <option value="@i" selected="@(Model.NumeroMesa == i)" disabled="@estaOcupada">
                                                Mesa @i @(estaOcupada ? "(Ocupada)" : "")
                                            </option>
                                        }
                                    </select>
                                </div>
                            }
                        </form>
                    </div>
                </div>

                @if (editable)
                {
                    <div class="premium-card">
                        <div class="card-body-custom">
                            <h6 class="fw-bold mb-3">Acciones</h6>
                            @{
                                bool tieneProductos = Model.Items.Any();
                                bool tieneCliente = !string.IsNullOrWhiteSpace(Model.Cliente);
                                bool mesaValida = Model.Modalidad != ModalidadPedido.EnMesa || (Model.NumeroMesa.HasValue && Model.NumeroMesa > 0);
                                bool puedeProceder = tieneProductos && tieneCliente && mesaValida;
                            }

                            <div class="d-grid gap-2">
                                <form method="post" asp-action="ProcederAlPago" class="mb-2">
                                    <input type="hidden" name="pedidoId" value="@Model.Id_Venta" />
                                    <button type="submit" class="btn btn-success btn-premium w-100 @(!puedeProceder ? "disabled" : "")">
                                        <i class="lni lni-credit-card me-2"></i> Proceder al Pago
                                    </button>
                                </form>
                                
                                <form method="post" asp-action="GuardarBorrador" class="mb-2">
                                    <input type="hidden" name="pedidoId" value="@Model.Id_Venta" />
                                    <button type="submit" class="btn btn-outline-primary btn-premium w-100">
                                        <i class="lni lni-save me-2"></i> Guardar Borrador
                                    </button>
                                </form>

                                @if (Model.Items.Any(i => i.Estado == PedidoEstado.Borrador || i.Estado == PedidoEstado.Pendiente))
                                {
                                    <button type="button" class="btn btn-warning btn-premium w-100 mb-2 text-white" onclick="iniciarPreparacion(@Model.Id_Venta)">
                                        <i class="lni lni-chef-hat me-2"></i> Enviar a Cocina
                                    </button>
                                }

                                @if (Model.Items.Any(i => i.Estado == PedidoEstado.Listo))
                                {
                                    <button type="button" class="btn btn-info btn-premium w-100 mb-2 text-white" onclick="marcarEntregado(@Model.Id_Venta)">
                                        <i class="lni lni-delivery me-2"></i> Marcar Entregado
                                    </button>
                                }

                                <button type="button" class="btn btn-outline-danger btn-premium w-100 mt-3" data-bs-toggle="modal" data-bs-target="#modalCancelarPedido">
                                    <i class="lni lni-close me-2"></i> Cancelar Pedido
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Columna Derecha: Productos -->
            <div class="col-lg-8">
                <div class="premium-card h-100">
                    <div class="card-header-custom d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold">🛒 Productos</h5>
                        @if (editable)
                        {
                            <button class="btn btn-primary btn-premium btn-sm" data-bs-toggle="modal" data-bs-target="#modalAgregarProducto">
                                <i class="lni lni-plus me-1"></i> Agregar Producto
                            </button>
                        }
                    </div>
                    <div class="card-body-custom p-0">
                        @if (Model.Items.Any())
                        {
                            <div class="table-responsive">
                                <table class="table mb-0">
                                    <thead class="bg-light">
                                        <tr>
                                            <th class="ps-4 py-3">Producto</th>
                                            <th class="text-center py-3">Cant.</th>
                                            <th class="text-end py-3">Precio</th>
                                            <th class="text-end pe-4 py-3">Subtotal</th>
                                            @if (editable) { <th class="text-center py-3"></th> }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Items)
                                        {
                                            <tr class="product-list-item">
                                                <td class="ps-4 py-3">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="fw-bold text-dark mb-0">@item.NombreProducto</div>
                                                        <span class="badge @GetBadgeClass(item.Estado) rounded-pill" style="font-size: 0.65rem;">@GetEstadoText(item.Estado)</span>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(item.Notas))
                                                    {
                                                        <small class="text-muted"><i class="lni lni-pencil-alt me-1"></i>@item.Notas</small>
                                                    }
                                                </td>
                                                <td class="text-center py-3" style="width: 120px;">
                                                    @if (editable)
                                                    {
                                                        <form method="post" asp-action="ActualizarCantidad" class="d-flex justify-content-center align-items-center gap-1">
                                                            <input type="hidden" name="pedidoId" value="@Model.Id_Venta" />
                                                            <input type="hidden" name="itemId" value="@item.Id_Detalle" />
                                                            <input type="number" name="cantidad" value="@item.Cantidad" min="1" class="form-control form-control-sm text-center px-1" style="width: 60px;" onchange="this.form.submit()" />
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-light text-dark border">@item.Cantidad</span>
                                                    }
                                                </td>
                                                <td class="text-end py-3 text-muted">@item.PrecioUnitario.ToString("C", numberFormat)</td>
                                                <td class="text-end pe-4 py-3 fw-bold text-dark">@item.Subtotal.ToString("C", numberFormat)</td>
                                                @if (editable)
                                                {
                                                    <td class="text-center py-3">
                                                        <div class="d-flex justify-content-center gap-1">
                                                            <button type="button" class="btn btn-light btn-sm rounded-circle text-primary" data-bs-toggle="modal" data-bs-target="#modalEditarNota" onclick="prepararEdicionNota(@item.Id_Detalle, '@Html.Raw(item.Notas?.Replace("'", "\\'"))')">
                                                                <i class="lni lni-pencil"></i>
                                                            </button>
                                                            <form method="post" asp-action="EliminarProducto" class="m-0">
                                                                <input type="hidden" name="pedidoId" value="@Model.Id_Venta" />
                                                                <input type="hidden" name="itemId" value="@item.Id_Detalle" />
                                                                <button type="submit" class="btn btn-light btn-sm rounded-circle text-danger" onclick="return confirm('¿Eliminar?')">
                                                                    <i class="lni lni-trash-can"></i>
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5 px-4">
                                <div class="avatar-lg bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                    <i class="lni lni-cart text-muted fs-1"></i>
                                </div>
                                <h5 class="text-muted">El carrito está vacío</h5>
                                <p class="text-sm text-muted">Agrega productos para comenzar el pedido.</p>
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-white border-top p-4">
                        <div class="d-flex flex-column align-items-end">
                            <div class="d-flex justify-content-between w-100" style="max-width: 250px;">
                                <span class="text-muted">Subtotal:</span>
                                <span class="fw-bold">@Model.Subtotal.ToString("C", numberFormat)</span>
                            </div>
                            <div class="d-flex justify-content-between w-100 pt-2 border-top" style="max-width: 250px;">
                                <span class="text-muted text-uppercase fw-bold">Total a Pagar:</span>
                                <h4 class="fw-bold text-primary mb-0">@Model.Total.ToString("C", numberFormat)</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Agregar Producto -->
@if (editable)
{
    <div class="modal fade" id="modalAgregarProducto" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold">Agregar Producto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <form method="post" asp-action="AgregarProducto" id="formAgregarProducto">
                        <input type="hidden" name="pedidoId" value="@Model.Id_Venta" />
                        
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label fw-bold">Producto</label>
                                <div class="position-relative">
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text bg-light border-end-0"><i class="lni lni-search-alt"></i></span>
                                        <input type="text" class="form-control border-start-0 ps-0" id="inputBuscarProducto" placeholder="Escriba el nombre del producto..." autocomplete="off">
                                    </div>
                                    <input type="hidden" name="productoId" id="selectProducto" required>
                                    
                                    <div class="list-group position-absolute w-100 shadow d-none" id="dropdownProductos" style="max-height: 250px; overflow-y: auto; z-index: 1050; top: 100%;">
                                        @foreach (var producto in ViewBag.Productos as List<VentaFacil.web.Models.Dto.ProductoDto> ?? new List<VentaFacil.web.Models.Dto.ProductoDto>())
                                        {
                                            <button type="button" class="list-group-item list-group-item-action producto-item text-start" 
                                                    data-id="@producto.Id_Producto" 
                                                    data-precio="@producto.Precio"
                                                    data-nombre="@producto.Nombre"
                                                    data-descripcion="@producto.Descripcion">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <span class="fw-bold text-dark">@producto.Nombre</span>
                                                        <br>
                                                        <small class="text-muted">@producto.Descripcion</small>
                                                    </div>
                                                    <span class="badge bg-primary rounded-pill">@producto.Precio.ToString("C", numberFormat)</span>
                                                </div>
                                            </button>
                                        }
                                        <div id="noResultadosProducto" class="list-group-item text-center text-muted d-none py-3">
                                            <i class="lni lni-warning mb-2 fs-4"></i><br>
                                            No se encontraron productos
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Cantidad</label>
                                <input type="number" name="cantidad" class="form-control form-select-lg" value="1" min="1" required />
                            </div>
                        </div>

                        <div id="infoProducto" class="mt-4 p-3 bg-light rounded border d-none">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="fw-bold mb-1" id="nombreProducto"></h6>
                                    <small class="text-muted" id="descripcionProducto"></small>
                                </div>
                                <span class="badge bg-primary fs-6" id="precioProducto"></span>
                            </div>
                        </div>

                        <div class="mt-4 text-end">
                            <button type="button" class="btn btn-light rounded-pill px-4 me-2" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary rounded-pill px-4" id="btnAgregar" disabled>
                                <i class="lni lni-plus me-1"></i> Agregar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Cancelar -->
    <div class="modal fade" id="modalCancelarPedido" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                <div class="modal-body p-4 text-center">
                    <div class="avatar-lg bg-danger bg-opacity-10 text-danger rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <i class="lni lni-warning fs-2"></i>
                    </div>
                    <h5 class="fw-bold mb-2">¿Cancelar Pedido?</h5>
                    <p class="text-muted mb-4">Esta acción no se puede deshacer. Por favor indica el motivo.</p>
                    
                    <form method="post" asp-action="CancelarPedido">
                        <input type="hidden" name="id" value="@Model.Id_Venta" />
                        <textarea class="form-control mb-4" name="razon" rows="3" placeholder="Motivo de cancelación..." required></textarea>
                        
                        <div class="d-flex gap-2 justify-content-center">
                            <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Volver</button>
                            <button type="submit" class="btn btn-danger rounded-pill px-4">Confirmar Cancelación</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Editar Nota -->
    <div class="modal fade" id="modalEditarNota" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold">Nota de Preparación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <form method="post" asp-action="ActualizarNotaProducto">
                        <input type="hidden" name="pedidoId" value="@Model.Id_Venta" />
                        <input type="hidden" name="itemId" id="inputNotaItemId" value="" />
                        <textarea class="form-control mb-4" name="notas" id="inputNotaText" rows="3" placeholder="Ej. Sin cebolla, extra salsa..."></textarea>
                        
                        <div class="d-flex gap-2 justify-content-end">
                            <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary rounded-pill px-4">Guardar Nota</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold" id="modalTitle">Confirmación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                        <i class="lni lni-question-circle fs-3"></i>
                    </div>
                    <div>
                        <p class="mb-0 text-muted" id="modalMessage">¿Estás seguro de realizar esta acción?</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" id="btnConfirmAction">Confirmar</button>
            </div>
        </div>
    </div>
</div>

<!-- Error Modal -->
<div class="modal fade" id="errorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-danger">Error</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                        <i class="lni lni-warning fs-3"></i>
                    </div>
                    <div>
                        <p class="mb-0 text-muted" id="errorMessage">Ha ocurrido un error inesperado.</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Variables globales para el modal
        let confirmModal;
        let errorModal;
        let currentAction = null;

        document.addEventListener('DOMContentLoaded', function() {
            confirmModal = new bootstrap.Modal(document.getElementById('confirmationModal'));
            errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
            
            // Verificar si hay caja abierta al cargar la página
            async function verificarCajaAbierta() {
                try {
                    const response = await fetch('@Url.Action("EstadoCaja", "Caja")');
                    const data = await response.json();
                    if (!data.existe) {
                        Toastify({
                            text: "No hay una caja abierta. No podrá procesar pagos hasta que abra una.",
                            duration: 10000,
                            gravity: "bottom",
                            position: "right",
                            style: {
                                background: "linear-gradient(to right, #4b6cb7, #182848)",
                            }
                        }).showToast();
                    }
                } catch (error) {
                    console.error("Error al verificar caja:", error);
                }
            }
            verificarCajaAbierta();

            // Configurar el botón de confirmación
            document.getElementById('btnConfirmAction').addEventListener('click', async function() {
                if (currentAction) {
                    const btn = this;
                    const originalText = btn.innerHTML;
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Procesando...';
                    
                    try {
                        await currentAction();
                        confirmModal.hide();
                    } catch (error) {
                        console.error(error);
                        confirmModal.hide();
                        showError('Ocurrió un error al procesar la solicitud.');
                    } finally {
                        btn.disabled = false;
                        btn.innerHTML = originalText;
                        currentAction = null;
                    }
                }
            });

            const selectProductoHidden = document.getElementById('selectProducto');
            const inputBuscarProducto = document.getElementById('inputBuscarProducto');
            const dropdownProductos = document.getElementById('dropdownProductos');
            const productoItems = document.querySelectorAll('.producto-item');
            const noResultadosProducto = document.getElementById('noResultadosProducto');

            const infoProducto = document.getElementById('infoProducto');
            const nombreProducto = document.getElementById('nombreProducto');
            const descripcionProducto = document.getElementById('descripcionProducto');
            const precioProducto = document.getElementById('precioProducto');
            const btnAgregar = document.getElementById('btnAgregar');

            if (inputBuscarProducto) {
                // Mostrar el dropdown al enfocar
                inputBuscarProducto.addEventListener('focus', function() {
                    if (productoItems.length > 0) {
                        dropdownProductos.classList.remove('d-none');
                        filtrarProductos();
                    }
                });

                // Ocultar al hacer clic fuera
                document.addEventListener('click', function(e) {
                    if (!inputBuscarProducto.contains(e.target) && !dropdownProductos.contains(e.target)) {
                        dropdownProductos.classList.add('d-none');
                    }
                });

                // Filtrar productos al escribir
                inputBuscarProducto.addEventListener('input', filtrarProductos);

                function filtrarProductos() {
                    const term = inputBuscarProducto.value.toLowerCase();
                    let hasVisible = false;

                    productoItems.forEach(item => {
                        const nombre = item.getAttribute('data-nombre').toLowerCase();
                        const desc = (item.getAttribute('data-descripcion') || '').toLowerCase();
                        if (nombre.includes(term) || desc.includes(term)) {
                            item.classList.remove('d-none');
                            hasVisible = true;
                        } else {
                            item.classList.add('d-none');
                        }
                    });

                    if (!hasVisible) {
                        noResultadosProducto.classList.remove('d-none');
                    } else {
                        noResultadosProducto.classList.add('d-none');
                    }

                    dropdownProductos.classList.remove('d-none');
                }

                // Seleccionar producto
                productoItems.forEach(item => {
                    item.addEventListener('click', function() {
                        const id = this.getAttribute('data-id');
                        const nombre = this.getAttribute('data-nombre');
                        const descripcion = this.getAttribute('data-descripcion') || 'Sin descripción';
                        const precio = parseFloat(this.getAttribute('data-precio'));

                        inputBuscarProducto.value = nombre;
                        selectProductoHidden.value = id;
                        
                        nombreProducto.textContent = nombre;
                        descripcionProducto.textContent = descripcion;
                        precioProducto.textContent = '¢' + precio.toFixed(2);
                        
                        infoProducto.classList.remove('d-none');
                        dropdownProductos.classList.add('d-none');
                        btnAgregar.disabled = false;
                    });
                });

                // Limpiar modal al cerrar
                $('#modalAgregarProducto').on('hidden.bs.modal', function() {
                    inputBuscarProducto.value = '';
                    selectProductoHidden.value = '';
                    document.querySelector('input[name="cantidad"]').value = 1;
                    infoProducto.classList.add('d-none');
                    dropdownProductos.classList.add('d-none');
                    btnAgregar.disabled = true;
                });
            }
        });

        // Helper para mostrar confirmación
        function showConfirm(title, message, action) {
            document.getElementById('modalTitle').innerText = title;
            document.getElementById('modalMessage').innerText = message;
            currentAction = action;
            confirmModal.show();
        }

        // Helper para mostrar error
        function showError(message) {
            document.getElementById('errorMessage').innerText = message;
            errorModal.show();
        }

        function iniciarPreparacion(id) {
            showConfirm(
                'Enviar a Cocina',
                `¿Deseas enviar el pedido #${id} a cocina para su preparación?`,
                async () => {
                    try {
                        const response = await fetch('@Url.Action("IniciarPreparacion", "Pedidos")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ pedidoId: id })
                        });
                        
                        const data = await response.json();
                        
                        if(data.success) {
                            window.location.href = '@Url.Action("Index", "Pedidos")';
                        } else {
                            throw new Error(data.message || 'Error al enviar a cocina');
                        }
                    } catch (error) {
                        console.error(error);
                        throw error;
                    }
                }
            );
        }

        function marcarEntregado(id) {
            showConfirm(
                'Marcar como Entregado',
                `¿Deseas registrar la entrega de los platillos listos a esta mesa?`,
                async () => {
                    try {
                        const response = await fetch('@Url.Action("MarcarComoEntregado", "Pedidos")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ pedidoId: id })
                        });
                        
                        const data = await response.json();
                        
                        if(data.success) {
                            window.location.reload();
                        } else {
                            throw new Error(data.message || 'Error al marcar como entregado');
                        }
                    } catch (error) {
                        console.error(error);
                        throw error;
                    }
                }
            );
        }

        function prepararEdicionNota(itemId, currentNota) {
            document.getElementById('inputNotaItemId').value = itemId;
            document.getElementById('inputNotaText').value = currentNota;
        }
    </script>
}

@functions {
    private string GetBadgeClass(PedidoEstado estado)
    {
        return estado switch
        {
            PedidoEstado.Borrador => "bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25",
            PedidoEstado.EnPreparacion => "bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25",
            PedidoEstado.Listo => "bg-success bg-opacity-10 text-success border border-success border-opacity-25",
            PedidoEstado.Entregado => "bg-info bg-opacity-10 text-info border border-info border-opacity-25",
            PedidoEstado.Cancelado => "bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25",
            _ => "bg-light text-dark"
        };
    }

    private string GetEstadoText(PedidoEstado estado)
    {
        return estado switch
        {
            PedidoEstado.Borrador => "Borrador",
            PedidoEstado.EnPreparacion => "En Cocina",
            PedidoEstado.Listo => "Listo",
            PedidoEstado.Entregado => "Entregado",
            PedidoEstado.Cancelado => "Cancelado",
            _ => estado.ToString()
        };
    }
}