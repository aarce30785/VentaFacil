@model List<VentaFacil.web.Models.Dto.PedidoDto>
@using VentaFacil.web.Models.Enum

@{
    Layout = "_LayoutPlantilla";
    ViewData["Title"] = "KDS - Cocina";
    var pedidosEnPreparacion = Model.Where(p => p.Items.Any(i => i.Estado == PedidoEstado.EnPreparacion || i.Estado == PedidoEstado.Pendiente || i.Estado == PedidoEstado.Borrador)).OrderBy(p => p.Fecha).ToList();
    var pedidosListos = Model.Where(p => p.Items.Any(i => i.Estado == PedidoEstado.Listo)).OrderByDescending(p => p.Fecha).ToList();
}

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        --success-gradient: linear-gradient(135deg, #10b981 0%, #059669 100%);
        --warning-gradient: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        --danger-gradient: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        --info-gradient: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        --card-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        --hover-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }

    .premium-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: var(--card-shadow);
        transition: all 0.3s ease;
        border: 1px solid rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .premium-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--hover-shadow);
    }

    .stat-card {
        position: relative;
        padding: 1.5rem;
        height: 100%;
        display: flex;
        align-items: center;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-right: 1rem;
    }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: #f8fafc;
        border-radius: 16px;
        border: 2px dashed #cbd5e1;
    }

    .animate-fade-in {
        animation: fadeIn 0.5s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* KDS Specific */
    .kds-card-header {
        padding: 1.25rem;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }
    .kds-card-body {
        padding: 1.25rem;
        flex-grow: 1;
        overflow-y: auto;
        max-height: 450px;
    }
    .kds-item {
        display: flex;
        align-items: flex-start;
        padding: 0.875rem 0;
        border-bottom: 1px dashed #e2e8f0;
    }
    .item-qty {
        background: #f1f5f9;
        font-weight: 700;
        width: 32px;
        height: 32px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 1rem;
    }
    .timer-badge {
        font-family: monospace;
        font-weight: 700;
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        background: rgba(255,255,255,0.25);
    }
    .timer-danger { background: #fff; color: #dc2626; animation: pulse 2s infinite; }
    @@keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7); }
        70% { box-shadow: 0 0 0 6px rgba(255, 255, 255, 0); }
        100% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0); }
    }
    .btn-action {
        width: 100%;
        padding: 0.875rem;
        border-radius: 12px;
        font-weight: 600;
        border: none;
        transition: 0.3s;
    }
    .btn-ready { background: var(--success-gradient); color: white; }
</style>

<div class="tables-wrapper">
    <!-- Hero Section -->
    <div class="hero-section d-flex flex-column flex-md-row justify-content-between align-items-center px-4" style="text-align: left; margin-top: -1.5rem; margin-bottom: 2rem;">
        <div class="position-relative z-1 text-center text-md-start mb-3 mb-md-0">
            <h1 class="hero-title fw-bold mb-2 text-white"><i class="lni lni-chef-hat me-2"></i>Cocina - KDS</h1>
            <p class="mb-0 text-white-50 fs-5">Monitor de preparación de pedidos en tiempo real.</p>
        </div>
        <div class="position-relative z-1 d-none d-md-block">
            <div class="breadcrumb-wrapper">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="#0" class="text-white-50">Dashboard</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Cocina</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <!-- Header Actions -->
    <div class="premium-card mb-4 p-4">
        <div class="row align-items-center g-3">
            <div class="col-12 col-lg-4">
                <div class="d-flex align-items-center justify-content-center justify-content-lg-start">
                    <div class="avatar bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                        <i class="lni lni-chef-hat fs-4"></i>
                    </div>
                    <div class="text-start">
                        <h6 class="mb-0">Bienvenido a Cocina</h6>
                        <p class="text-sm text-muted mb-0">Gestión de Preparación</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="position-relative w-100">
                    <input type="text" id="filtroKds" class="form-control rounded-pill ps-5 py-2 w-100" placeholder="Filtrar pedidos..." onkeyup="filtrarPedidos()">
                    <i class="lni lni-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 text-center text-lg-end">
                <div class="d-flex justify-content-center justify-content-lg-end align-items-center gap-3">
                    <button class="main-btn warning-btn btn-hover rounded-pill px-4" onclick="location.reload()">
                        <i class="lni lni-reload me-2"></i> Actualizar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="row g-4 mb-4">
        <div class="col-6 col-md-4 col-xl-2">
            <div class="premium-card stat-card p-3 p-md-4 flex-column flex-sm-row text-center text-sm-start">
                <div class="stat-icon bg-warning bg-opacity-10 text-warning mb-2 mb-sm-0 mx-auto mx-sm-0 me-sm-3">
                    <i class="lni lni-timer"></i>
                </div>
                <div>
                    <h3 class="mb-0 fw-bold">@pedidosEnPreparacion.Count</h3>
                    <span class="text-sm text-muted">En Preparación</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="premium-card stat-card p-3 p-md-4 flex-column flex-sm-row text-center text-sm-start">
                <div class="stat-icon bg-success bg-opacity-10 text-success mb-2 mb-sm-0 mx-auto mx-sm-0 me-sm-3">
                    <i class="lni lni-checkmark-circle"></i>
                </div>
                <div>
                    <h3 class="mb-0 fw-bold">@pedidosListos.Count</h3>
                    <span class="text-sm text-muted">Listos</span>
                </div>
            </div>
        </div>
    </div>

    <div id="contenedorPedidos">
        @if (!pedidosEnPreparacion.Any() && !pedidosListos.Any())
        {
            <div class="row">
                <div class="col-12">
                    <div class="empty-state animate-fade-in">
                        <i class="lni lni-dinner text-muted opacity-25" style="font-size: 5rem;"></i>
                        <h3 class="mt-4 fw-bold">Todo tranquilo por ahora</h3>
                        <p>No hay pedidos activos en cocina. Los nuevos pedidos aparecerán aquí automáticamente.</p>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                <!-- Pedidos en Preparación -->
                @foreach (var pedido in pedidosEnPreparacion)
                {
                    <div class="col-xl-3 col-lg-4 col-md-6 pedido-item" data-texto="@pedido.Id_Venta @pedido.Cliente @pedido.NumeroMesa">
                        <div class="premium-card h-100 d-flex flex-column">
                            <div class="kds-card-header rounded-top-0 border-0" style="background: var(--warning-gradient)">
                                <div>
                                    <h5 class="mb-0 fw-bold text-white">#@pedido.Id_Venta</h5>
                                    <small class="text-white opacity-75">@pedido.Cliente</small>
                                </div>
                                <div class="text-end">
                                    <div class="timer-badge" data-start="@pedido.Fecha.ToString("yyyy-MM-ddTHH:mm:ss")">00:00</div>
                                    <small class="text-white fw-bold d-block mt-1">
                                        @if(pedido.Modalidad == ModalidadPedido.EnMesa) { <i class="lni lni-restaurant"></i> @:Mesa @pedido.NumeroMesa
                                        } else { <i class="lni lni-takeaway"></i> @:Llevar
                                        }
                                    </small>
                                </div>
                            </div>
                            <div class="kds-card-body">
                                @if (!string.IsNullOrEmpty(pedido.Notas))
                                {
                                    <div class="alert alert-warning p-2 mb-3 text-sm">
                                        <i class="lni lni-warning me-1"></i> <strong>Nota:</strong> @pedido.Notas
                                    </div>
                                }
                                @foreach (var item in pedido.Items.Where(i => i.Estado == PedidoEstado.EnPreparacion || i.Estado == PedidoEstado.Pendiente || i.Estado == PedidoEstado.Borrador))
                                {
                                    <div class="kds-item">
                                        <div class="item-qty">@item.Cantidad</div>
                                        <div class="item-details">
                                            <div class="item-name">@item.NombreProducto</div>
                                            @if (!string.IsNullOrEmpty(item.Notas))
                                            {
                                                <div class="item-notes">@item.Notas</div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="p-3 bg-light border-top mt-auto">
                                <div class="d-flex gap-2">
                                    <button class="btn btn-white border flex-grow-0 rounded-3" onclick="agregarNota(@pedido.Id_Venta)">
                                        <i class="lni lni-pencil text-muted"></i>
                                    </button>
                                    <button class="btn-action btn-ready" onclick="marcarListo(@pedido.Id_Venta)">
                                        <i class="lni lni-checkmark-circle me-1"></i> LISTO
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Pedidos Listos -->
                @foreach (var pedido in pedidosListos)
                {
                    <div class="col-xl-3 col-lg-4 col-md-6 pedido-item" data-texto="@pedido.Id_Venta @pedido.Cliente @pedido.NumeroMesa">
                        <div class="premium-card h-100 d-flex flex-column opacity-75">
                            <div class="kds-card-header rounded-top-0 border-0" style="background: var(--success-gradient)">
                                <div>
                                    <h5 class="mb-0 fw-bold text-white">#@pedido.Id_Venta</h5>
                                    <small class="text-white opacity-75">@pedido.Cliente</small>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-white text-success rounded-pill px-2">LISTO</span>
                                </div>
                            </div>
                            <div class="kds-card-body">
                                @foreach (var item in pedido.Items.Where(i => i.Estado == PedidoEstado.Listo))
                                {
                                    <div class="kds-item">
                                        <div class="item-qty bg-success bg-opacity-10 text-success">@item.Cantidad</div>
                                        <div class="item-details">
                                            <div class="item-name">@item.NombreProducto</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Modal Nota -->
<div class="modal fade" id="modalNota" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Agregar Nota de Cocina</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="pedidoIdNota">
                <textarea class="form-control form-control-lg" id="textoNota" rows="3" placeholder="Escribe una nota..."></textarea>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" onclick="guardarNota()">Guardar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Confirmación -->
<div class="modal fade" id="modalConfirmacion" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold" id="modalConfirmacionTitulo">Confirmación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalConfirmacionMensaje">
                ¿Está seguro de realizar esta acción?
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" id="btnConfirmarAccion">Confirmar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Mensaje (Alerta) -->
<div class="modal fade" id="modalMensaje" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Información</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalMensajeTexto">
                Operación realizada con éxito.
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-dismiss="modal">Aceptar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // --- Modals Helpers ---
        function mostrarMensaje(mensaje, titulo = 'Información') {
            document.querySelector('#modalMensaje .modal-title').textContent = titulo;
            document.getElementById('modalMensajeTexto').textContent = mensaje;
            new bootstrap.Modal(document.getElementById('modalMensaje')).show();
        }

        let confirmCallback = null;
        function mostrarConfirmacion(titulo, mensaje, callback) {
            document.getElementById('modalConfirmacionTitulo').textContent = titulo;
            document.getElementById('modalConfirmacionMensaje').textContent = mensaje;
            confirmCallback = callback;
            new bootstrap.Modal(document.getElementById('modalConfirmacion')).show();
        }

        document.getElementById('btnConfirmarAccion').addEventListener('click', function() {
            if (confirmCallback) confirmCallback();
            bootstrap.Modal.getInstance(document.getElementById('modalConfirmacion')).hide();
        });

        // --- Timers Logic ---
        function updateTimers() {
            const now = new Date();
            document.querySelectorAll('.timer-badge').forEach(el => {
                const start = new Date(el.dataset.start);
                const diff = Math.floor((now - start) / 1000); // seconds
                
                const mins = Math.floor(diff / 60);
                const secs = diff % 60;
                
                el.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
                
                // Visual Alerts
                el.className = 'timer-badge'; // reset
                if (mins >= 20) el.classList.add('timer-danger');
                else if (mins >= 10) el.classList.add('timer-warning');
                else el.classList.add('timer-normal');
            });
        }
        
        setInterval(updateTimers, 1000);
        updateTimers(); // initial call

        // --- Filtering ---
        function filtrarPedidos() {
            const term = document.getElementById('filtroKds').value.toLowerCase();
            document.querySelectorAll('.pedido-item').forEach(el => {
                const text = el.dataset.texto.toLowerCase();
                el.style.display = text.includes(term) ? 'block' : 'none';
            });
        }

        // --- Actions ---
        function getCsrfToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        }

        function marcarListo(id) {
            mostrarConfirmacion('Pedido Listo', '¿Confirmar que el pedido #' + id + ' está listo?', async () => {
                try {
                    const res = await fetch('/Pedidos/MarcarComoListo', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ pedidoId: id })
                    });
                    if(res.ok) location.reload();
                    else mostrarMensaje('Error al actualizar el estado del pedido', 'Error');
                } catch(e) { console.error(e); mostrarMensaje('Error de conexión', 'Error'); }
            });
        }

        function marcarEntregado(id) {
             mostrarConfirmacion('Pedido Entregado', '¿Confirmar que el pedido #' + id + ' ha sido entregado?', async () => {
                try {
                    const res = await fetch('/Pedidos/MarcarComoEntregado', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ pedidoId: id })
                    });
                    if(res.ok) location.reload();
                    else mostrarMensaje('Error al actualizar el estado del pedido', 'Error');
                } catch(e) { console.error(e); mostrarMensaje('Error de conexión', 'Error'); }
            });
        }

        function agregarNota(id) {
            document.getElementById('pedidoIdNota').value = id;
            document.getElementById('textoNota').value = '';
            new bootstrap.Modal(document.getElementById('modalNota')).show();
        }

        async function guardarNota() {
            const id = document.getElementById('pedidoIdNota').value;
            const nota = document.getElementById('textoNota').value;
            
            try {
                const res = await fetch('/Pedidos/AgregarNotaCocina', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ pedidoId: parseInt(id), nota: nota })
                });
                if(res.ok) {
                    location.reload();
                } else {
                    mostrarMensaje('Error al guardar la nota', 'Error');
                }
            } catch(e) { console.error(e); mostrarMensaje('Error de conexión', 'Error'); }
        }

        // Auto refresh every 30s
        setInterval(() => {
            // Simple reload for now, could be optimized to check for changes first
            location.reload();
        }, 30000);
    </script>
}
