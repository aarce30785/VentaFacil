@model VentaFacil.web.Models.Dto.RegistrarHorasDto

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/clockpicker/0.0.7/jquery-clockpicker.min.css" />
}

<div class="form-wrapper">
    <div class="hero-section d-flex flex-column flex-md-row justify-content-between align-items-center px-4 mb-4" style="margin-top: -1.5rem;">
        <div class="position-relative z-1 text-center text-md-start mb-3 mb-md-0">
            <h1 class="hero-title fw-bold mb-2 text-white"><i class="lni lni-timer me-2"></i>Registrar Horas</h1>
            <p class="mb-0 text-white-50 fs-5">Control de asistencia y jornada laboral.</p>
        </div>
        <div class="position-relative z-1">
            @if (User.IsInRole("Administrador"))
            {
                <a href="/Planilla/AprobacionHoras" class="main-btn warning-btn btn-hover rounded-pill px-4">
                    <i class="lni lni-checkmark-circle me-2"></i> Aprobación de Horas
                </a>
            }
        </div>
    </div>
    <div class="row g-4">
        <!-- Formulario -->
        <div class="col-12 col-xl-5">
            <div class="premium-card p-4">
                <div class="mb-4 d-flex align-items-center">
                    <div class="icon-box bg-primary bg-opacity-10 text-primary rounded-3 me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                        <i class="lni lni-pencil-alt"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Formulario de Registro</h5>
                </div>
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible" role="alert">
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        <div class="alert-message">
                            <strong>Error:</strong> @TempData["Error"]
                        </div>
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible" role="alert">
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        <div class="alert-message">
                            <strong>Éxito:</strong> @TempData["Success"]
                        </div>
                    </div>
                }
                <form asp-action="RegistrarHoras" method="post" id="formRegistrarHoras">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id_Planilla" />
                    <div class="mb-3">
                        <label asp-for="Id_Usr" class="form-label">Colaborador</label>
                        <select asp-for="Id_Usr" class="form-select" asp-items="ViewBag.Usuarios">
                            <option value="">Seleccione un colaborador...</option>
                        </select>
                        <span asp-validation-for="Id_Usr" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Hora de Entrada</label>
                        <div class="row g-2">
                            <div class="col-md-7">
                                <input type="date" id="fechaInicioDate" class="form-control" required />
                            </div>
                            <div class="col-md-5">
                                <div class="input-group clockpicker" data-autoclose="true">
                                    <input type="text" id="fechaInicioTime" class="form-control" placeholder="00:00" required>
                                    <span class="input-group-text">
                                        <i class="far fa-clock"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <input type="hidden" asp-for="FechaInicio" />
                        <span asp-validation-for="FechaInicio" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="checkIncompleta">
                            <label class="form-check-label" for="checkIncompleta">Marcar como jornada incompleta/interrumpida</label>
                        </div>
                    </div>
                    <div class="mb-3" id="divFechaFinal">
                        <label class="form-label">Hora de Salida</label>
                        <div class="row g-2">
                            <div class="col-md-7">
                                <input type="date" id="fechaFinalDate" class="form-control" />
                            </div>
                            <div class="col-md-5">
                                <div class="input-group clockpicker" data-autoclose="true">
                                    <input type="text" id="fechaFinalTime" class="form-control" placeholder="00:00">
                                    <span class="input-group-text">
                                        <i class="far fa-clock"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <input type="hidden" asp-for="FechaFinal" />
                        <span asp-validation-for="FechaFinal" class="text-danger"></span>
                    </div>
                    <div class="mb-3" id="divPausa">
                        <label class="form-label">Tiempos de Pausa (Opcional)</label>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small">Inicio Pausa</label>
                                <div class="input-group clockpicker" data-autoclose="true">
                                    <input type="text" id="horaInicioPausaTime" class="form-control" placeholder="00:00">
                                    <span class="input-group-text"><i class="far fa-clock"></i></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">Fin Pausa</label>
                                <div class="input-group clockpicker" data-autoclose="true">
                                    <input type="text" id="horaFinPausaTime" class="form-control" placeholder="00:00">
                                    <span class="input-group-text"><i class="far fa-clock"></i></span>
                                </div>
                            </div>
                        </div>
                        <input type="hidden" asp-for="HoraInicioPausa" />
                        <input type="hidden" asp-for="HoraFinPausa" />
                        <span asp-validation-for="HoraInicioPausa" class="text-danger"></span>
                        <span asp-validation-for="HoraFinPausa" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch px-0">
                            <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-primary bg-opacity-10 border border-primary border-opacity-25">
                                <div>
                                    <label class="form-check-label fw-bold text-primary mb-0" for="EsFeriado">
                                        <i class="fas fa-umbrella-beach me-2"></i>¿Es Día Feriado?
                                    </label>
                                    <div class="small text-muted">Pago doble por jornada</div>
                                </div>
                                <div class="form-check form-switch m-0">
                                    <input class="form-check-input" type="checkbox" asp-for="EsFeriado" style="width: 3em; height: 1.5em; cursor: pointer;">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Observaciones" class="form-label">Observaciones</label>
                        <textarea asp-for="Observaciones" class="form-control" rows="2" style="border-radius: 16px;"></textarea>
                    </div>
                    <div class="d-grid gap-3 mt-4">
                        <button type="submit" class="main-btn primary-btn btn-hover rounded-pill py-3">
                            <i class="lni lni-save me-2"></i> Registrar Jornada
                        </button>
                        <a asp-action="Consultar" class="main-btn dark-btn-outline btn-hover rounded-pill py-3">
                            <i class="lni lni-close me-2"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
        
        <!-- Panel Lateral: Jornadas de la Semana -->
        <div class="col-12 col-xl-7">
            <div class="premium-card p-4 h-100">
                <div class="mb-4 d-flex align-items-center">
                    <div class="icon-box bg-success bg-opacity-10 text-success rounded-3 me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                        <i class="lni lni-calendar"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Jornadas Registradas (Semana Actual)</h5>
                </div>
                <div id="weeklyShiftsContainer">
                    <div class="text-center text-muted p-5 mt-4">
                        <i class="lni lni-calendar fs-1 mb-3 opacity-25"></i>
                        <p>Seleccione un colaborador para ver sus jornadas de esta semana.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de AprobaciÃ³n/Rechazo -->
<div class="modal fade" id="modalAprobacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4">
            <form asp-action="ProcesarAprobacion" method="post">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="modalTitle">Procesar Registro</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p id="modalMensaje" class="text-muted"></p>
                    
                    <input type="hidden" name="idPlanilla" id="modalIdPlanilla" />
                    <input type="hidden" name="estado" id="modalEstado" />
                    <input type="hidden" name="returnUrl" value="@Url.Action("RegistrarHoras", "Planilla")" />
                    
                    <div class="mb-3" id="divExtras">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="aprobarExtras" id="aprobarExtras" value="true">
                            <label class="form-check-label fw-medium" for="aprobarExtras">Aprobar horas extra</label>
                        </div>
                        <small class="text-muted">Si se desactiva, las horas extra no se incluirán en el pago.</small>
                    </div>

                    <div class="mb-3">
                        <label for="observaciones" class="form-label fw-medium">Observaciones (Opcional)</label>
                        <textarea class="form-control rounded-3" name="observaciones" id="observaciones" rows="3" placeholder="Ej. Aprobado con ajuste de tiempo..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4" id="btnConfirmar">Confirmar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/clockpicker/0.0.7/jquery-clockpicker.min.js"></script>
    <script>
        const esAdmin = @(User.IsInRole("Administrador").ToString().ToLower());

        document.addEventListener("DOMContentLoaded", function() {
            // Inicializar ClockPicker
            $('.clockpicker').clockpicker({
                twelvehour: true,
                donetext: 'Listo'
            });

            // Referencias a elementos
            const form = document.getElementById('formRegistrarHoras');
            const checkIncompleta = document.getElementById("checkIncompleta");
            const divFechaFinal = document.getElementById("divFechaFinal");
            
            // Inputs ocultos (Modelo)
            const hiddenInicio = document.querySelector('input[name="FechaInicio"]');
            const hiddenFinal = document.querySelector('input[name="FechaFinal"]');
            const hiddenInicioPausa = document.querySelector('input[name="HoraInicioPausa"]');
            const hiddenFinPausa = document.querySelector('input[name="HoraFinPausa"]');

            // Inputs visibles
            const dateInicio = document.getElementById('fechaInicioDate');
            const timeInicio = document.getElementById('fechaInicioTime');
            const dateFinal = document.getElementById('fechaFinalDate');
            const timeFinal = document.getElementById('fechaFinalTime');
            const timeInicioPausa = document.getElementById('horaInicioPausaTime');
            const timeFinPausa = document.getElementById('horaFinPausaTime');

            // Inicializar valores desde el modelo (si existen)
            function initInputsFromModel(hiddenInput, dateInput, timeInput) {
                if (hiddenInput.value) {
                    const dt = new Date(hiddenInput.value);
                    if (!isNaN(dt.getTime())) {
                        // Formato YYYY-MM-DD
                        const yyyy = dt.getFullYear();
                        const mm = String(dt.getMonth() + 1).padStart(2, '0');
                        const dd = String(dt.getDate()).padStart(2, '0');
                        dateInput.value = `${yyyy}-${mm}-${dd}`;

                        // Formato HH:mm (12h o 24h, clockpicker maneja input text)
                        // Usaremos toLocaleTimeString para formato amigable si se desea, 
                        // pero para clockpicker mejor HH:mm 24h o 12h. 
                        // Vamos a ponerlo en formato simple HH:mm y dejar que clockpicker lo parsee si es necesario
                        let hours = dt.getHours();
                        let minutes = String(dt.getMinutes()).padStart(2, '0');
                        // Convertir a 12h para mostrar bonito al inicio? Clockpicker lo hace.
                        // Dejemos formato 24h en el value, clockpicker con twelvehour: true lo mostrará bien?
                        // Probemos formato HH:mm
                        timeInput.value = `${String(hours).padStart(2, '0')}:${minutes}`;
                    }
                }
            }

            initInputsFromModel(hiddenInicio, dateInicio, timeInicio);
            initInputsFromModel(hiddenFinal, dateFinal, timeFinal);
            initInputsFromModel(hiddenInicioPausa, dateInicio, timeInicioPausa);
            initInputsFromModel(hiddenFinPausa, dateInicio, timeFinPausa);

            // Función para actualizar el input hidden
            function updateHiddenInput(dateInput, timeInput, hiddenInput) {
                if (dateInput.value && timeInput.value) {
                    // Combinar fecha y hora
                    // timeInput.value viene como "08:00PM" o "20:00" dependiendo del picker
                    // Necesitamos un formato ISO válido para el backend binding
                    
                    // Crear fecha base
                    const dateParts = dateInput.value.split('-');
                    const timeString = timeInput.value;
                    
                    // Parsear hora (Clockpicker devuelve string como '13:00' o '01:00PM')
                    // Vamos a usar un objeto Date auxiliar
                    const tempDate = new Date(`${dateInput.value}T${convertTo24Hour(timeString)}`);
                    
                    if (!isNaN(tempDate.getTime())) {
                        // Ajustar a ISO string local (sin Z para que el binding lo tome como local)
                        // Ojo: toISOString() usa UTC.
                        // Mejor formato: YYYY-MM-DDTHH:mm:ss
                        const yyyy = tempDate.getFullYear();
                        const mm = String(tempDate.getMonth() + 1).padStart(2, '0');
                        const dd = String(tempDate.getDate()).padStart(2, '0');
                        const hh = String(tempDate.getHours()).padStart(2, '0');
                        const min = String(tempDate.getMinutes()).padStart(2, '0');
                        
                        hiddenInput.value = `${yyyy}-${mm}-${dd}T${hh}:${min}:00`;
                    }
                } else {
                    hiddenInput.value = '';
                }
            }

            function convertTo24Hour(timeStr) {
                // Soporte básico para HH:mm AM/PM o HH:mm
                // Si no tiene AM/PM asumimos 24h
                const match = timeStr.match(/(\d+):(\d+)\s*(AM|PM)?/i);
                if (!match) return "00:00"; // Fallback

                let [_, hours, minutes, modifier] = match;
                hours = parseInt(hours, 10);

                if (modifier) {
                    if (modifier.toUpperCase() === 'PM' && hours < 12) hours += 12;
                    if (modifier.toUpperCase() === 'AM' && hours === 12) hours = 0;
                }
                
                return `${String(hours).padStart(2, '0')}:${minutes}`;
            }

            // Listeners para actualizar hidden inputs
            dateInicio.addEventListener('change', () => {
                dateFinal.value = dateInicio.value;
                updateHiddenInput(dateInicio, timeInicio, hiddenInicio);
                updateHiddenInput(dateFinal, timeFinal, hiddenFinal);
            });

            timeInicio.addEventListener('change', () => {
                updateHiddenInput(dateInicio, timeInicio, hiddenInicio);
                // Para clockpicker, el evento change se dispara al cerrar
            });

            [dateFinal, timeFinal].forEach(el => {
                el.addEventListener('change', () => updateHiddenInput(dateFinal, timeFinal, hiddenFinal));
            });

            [timeInicioPausa].forEach(el => {
                el.addEventListener('change', () => updateHiddenInput(dateInicio, timeInicioPausa, hiddenInicioPausa));
            });
            [timeFinPausa].forEach(el => {
                el.addEventListener('change', () => updateHiddenInput(dateInicio, timeFinPausa, hiddenFinPausa));
            });
            
            // JQuery event listener para clockpicker (a veces nativo change no salta igual)
            $('.clockpicker').find('input').change(function() {
                if(this.id === 'fechaInicioTime') updateHiddenInput(dateInicio, timeInicio, hiddenInicio);
                if(this.id === 'fechaFinalTime') updateHiddenInput(dateFinal, timeFinal, hiddenFinal);
                if(this.id === 'horaInicioPausaTime') updateHiddenInput(dateInicio, timeInicioPausa, hiddenInicioPausa);
                if(this.id === 'horaFinPausaTime') updateHiddenInput(dateInicio, timeFinPausa, hiddenFinPausa);
            });


            // Lógica de Jornada Incompleta
            function toggleFechaFinal() {
                if (checkIncompleta.checked) {
                    divFechaFinal.style.display = "none";
                    hiddenFinal.value = ""; 
                    dateFinal.value = "";
                    timeFinal.value = "";
                    // Remover required
                    dateFinal.removeAttribute('required');
                    timeFinal.removeAttribute('required');
                } else {
                    divFechaFinal.style.display = "block";
                    // Agregar required si es necesario
                    // dateFinal.setAttribute('required', '');
                    // timeFinal.setAttribute('required', '');
                }
            }

            checkIncompleta.addEventListener("change", toggleFechaFinal);
            toggleFechaFinal(); // Estado inicial
            
            // Antes de enviar, asegurar que los hidden están actualizados
            form.addEventListener('submit', function() {
                updateHiddenInput(dateInicio, timeInicio, hiddenInicio);
                updateHiddenInput(dateInicio, timeInicioPausa, hiddenInicioPausa);
                updateHiddenInput(dateInicio, timeFinPausa, hiddenFinPausa);
                
                if (!checkIncompleta.checked) {
                    updateHiddenInput(dateFinal, timeFinal, hiddenFinal);
                } else {
                    hiddenFinal.value = ""; // Asegurar null
                }
            });

            // Lógica para cargar jornadas de la semana actual
            const selectColaborador = document.getElementById('Id_Usr');
            const weeklyShiftsContainer = document.getElementById('weeklyShiftsContainer');

            selectColaborador.addEventListener('change', function() {
                const userId = this.value;
                if (!userId) {
                    weeklyShiftsContainer.innerHTML = `
                        <div class="text-center text-muted p-4 mt-4">
                            <i class="fas fa-calendar-alt fa-3x mb-3" style="color: #dee2e6;"></i>
                            <p>Seleccione un colaborador para ver sus jornadas de esta semana.</p>
                        </div>`;
                    return;
                }

                // Show loading state
                weeklyShiftsContainer.innerHTML = '<div class="text-center p-4 mt-4"><div class="spinner-border text-primary" role="status"></div><p class="mt-2 text-muted">Cargando jornadas...</p></div>';

                fetch(`/Planilla/ObtenerJornadasSemanaActual?idUsuario=${userId}`)
                    .then(r => r.json())
                    .then(res => {
                        if (res.success) {
                            renderWeeklyShifts(res.data);
                        } else {
                            weeklyShiftsContainer.innerHTML = `<div class="alert alert-danger m-3 border-0 shadow-sm">${res.message}</div>`;
                        }
                    })
                    .catch(err => {
                        weeklyShiftsContainer.innerHTML = `<div class="alert alert-danger m-3 border-0 shadow-sm">Error de conexión al cargar las jornadas.</div>`;
                    });
            });

            function renderWeeklyShifts(jornadas) {
                if (!jornadas || jornadas.length === 0) {
                    weeklyShiftsContainer.innerHTML = `
                        <div class="text-center p-5">
                            <i class="lni lni-information fs-1 text-info opacity-25 mb-3"></i>
                            <p class="text-muted">No se encontraron jornadas registradas para esta semana.</p>
                        </div>`;
                    return;
                }

                let html = '<div class="table-responsive"><table class="table premium-table align-middle mb-0">';
                html += `
                    <thead>
                        <tr>
                            <th class="ps-4">Fecha</th>
                            <th>Entrada / Salida</th>
                            <th class="text-center">Horas</th>
                            <th class="text-center">Estado</th>
                            ${esAdmin ? '<th class="text-end pe-4">Acciones</th>' : ''}
                        </tr>
                    </thead>
                    <tbody>`;
                
                let totalHoras = 0;
                let totalExtras = 0;

                jornadas.forEach(j => {
                    const dtInicio = new Date(j.FechaInicio);
                    const fechaStr = dtInicio.toLocaleDateString('es-CR', { weekday: 'short', day: '2-digit', month: 'short' });
                    const entradaStr = dtInicio.toLocaleTimeString('es-CR', { hour: '2-digit', minute:'2-digit' });
                    
                    let salidaStr = '<i>En curso</i>';
                    if (j.FechaFinal) {
                        salidaStr = new Date(j.FechaFinal).toLocaleTimeString('es-CR', { hour: '2-digit', minute:'2-digit' });
                    }
                    
                    let bgEstado = 'bg-secondary';
                    if (j.EstadoRegistro === 'Completada' || j.EstadoRegistro === 'Procesado') bgEstado = 'bg-success';
                    if (j.EstadoRegistro === 'Incompleta') bgEstado = 'bg-warning text-dark';
                    if (j.EstadoRegistro === 'Pendiente') bgEstado = 'bg-info text-dark';

                    let accionesHtml = '';
                    if (esAdmin && (j.EstadoRegistro === 'Pendiente' || j.EstadoRegistro === 'Incompleta')) {
                        accionesHtml = `
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn btn-sm btn-white text-success rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: white;" onclick="abrirModalAprobacion(${j.Id_Planilla}, 'Completada', '${fechaStr}')" title="Aprobar">
                                        <i class="lni lni-checkmark"></i>
                                    </button>
                                    <button class="btn btn-sm btn-white text-danger rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: white;" onclick="abrirModalAprobacion(${j.Id_Planilla}, 'Rechazada', '${fechaStr}')" title="Rechazar">
                                        <i class="lni lni-close"></i>
                                    </button>
                                </div>
                            </td>`;
                    } else if (esAdmin) {
                        accionesHtml = '<td class="text-end pe-4"></td>';
                    }

                    html += `
                        <tr>
                            <td class="ps-4"><strong class="text-dark text-capitalize">${fechaStr}</strong></td>
                            <td>
                                <div class="d-flex flex-column" style="font-size: 0.9rem;">
                                    <span class="text-success"><i class="lni lni-arrow-right me-1" style="font-size: 0.8em;"></i>${entradaStr}</span>
                                    <span class="text-danger"><i class="lni lni-arrow-left me-1" style="font-size: 0.8em;"></i>${salidaStr}</span>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="fw-bold">${j.HorasTrabajadas.toFixed(1)}h</span>
                                ${(j.HorasExtras > 0) ? `<br/><small class="text-muted">+${j.HorasExtras.toFixed(1)}h extra</small>` : ''}
                                ${j.EsFeriado ? '<br/><span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-2 mt-1"><i class="lni lni-beach me-1"></i>Feriado</span>' : ''}
                            </td>
                            <td class="text-center"><span class="badge ${bgEstado} rounded-pill px-3">${j.EstadoRegistro}</span></td>
                            ${accionesHtml}
                        </tr>
                    `;
                    totalHoras += j.HorasTrabajadas;
                    totalExtras += j.HorasExtras;
                });

                html += '</tbody></table></div>';
                
                html += `
                    <div class="mt-4 p-4 rounded-4" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted fw-bold text-uppercase text-xs">Total Semana:</span>
                            <div class="text-end">
                                <span class="text-dark fw-bold" style="font-size: 1.25rem;">${totalHoras.toFixed(1)} <small class="text-muted fw-normal" style="font-size: 0.9rem;">h regulares</small></span>
                                ${(totalExtras > 0) ? `<br/><span class="text-success fw-bold">${totalExtras.toFixed(1)} <small class="text-muted fw-normal">h extras</small></span>` : ''}
                            </div>
                        </div>
                    </div>`;
                
                weeklyShiftsContainer.innerHTML = html;
            }

            // Exponer al scope global
            window.abrirModalAprobacion = function(id, estado, fecha) {
                document.getElementById('modalIdPlanilla').value = id;
                document.getElementById('modalEstado').value = estado;
                document.getElementById('observaciones').value = '';

                const titulo = document.getElementById('modalTitle');
                const mensaje = document.getElementById('modalMensaje');
                const btn = document.getElementById('btnConfirmar');
                const divExtras = document.getElementById('divExtras');
                const chkExtras = document.getElementById('aprobarExtras');

                // Obtain the name from the dropdown selection for a nicer message
                const currentName = selectColaborador.options[selectColaborador.selectedIndex].text;

                if(estado === 'Completada') {
                    titulo.textContent = 'Aprobar Horas';
                    titulo.classList.remove('text-danger');
                    titulo.classList.add('text-success');
                    mensaje.innerHTML = `¿Está seguro que desea <strong>aprobar</strong> las horas de ${currentName} del dÃ­a ${fecha}?`;
                    btn.className = 'btn btn-success rounded-pill px-4';
                    btn.textContent = 'Aprobar';
                    divExtras.style.display = 'block';
                    chkExtras.checked = true;
                } else {
                    titulo.textContent = 'Rechazar Horas';
                    titulo.classList.remove('text-success');
                    titulo.classList.add('text-danger');
                    mensaje.innerHTML = `¿Está seguro que desea <strong>rechazar</strong> las horas de ${currentName} del dÃ­a ${fecha}?`;
                    btn.className = 'btn btn-danger rounded-pill px-4';
                    btn.textContent = 'Rechazar';
                    divExtras.style.display = 'none';
                    chkExtras.checked = false;
                }

                var modal = new bootstrap.Modal(document.getElementById('modalAprobacion'));
                modal.show();
            };
        });
    </script>
}