@model List<VentaFacil.web.Models.Dto.PedidoDto>
@using VentaFacil.web.Models.Enum

@{
    Layout = "_LayoutPlantilla";
    ViewData["Title"] = "Panel de Mesas";
    int totalMesas = ViewBag.TotalMesas as int? ?? 20;

    var cultureCR = new System.Globalization.CultureInfo("es-CR");
    var numberFormat = (System.Globalization.NumberFormatInfo)cultureCR.NumberFormat.Clone();
    numberFormat.CurrencySymbol = "¢";
}

<style>
    :root {
        --card-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        --hover-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        --success-gradient: linear-gradient(135deg, #10b981 0%, #059669 100%);
        --warning-gradient: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        --info-gradient: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    }

    .premium-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: var(--card-shadow);
        transition: all 0.3s ease;
        border: 1px solid rgba(0,0,0,0.05);
        overflow: hidden;
        height: 100%;
        position: relative;
    }

    .premium-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--hover-shadow);
    }

    .bg-gradient-success { background: var(--success-gradient); }
    .bg-gradient-warning { background: var(--warning-gradient); }
    .bg-gradient-info { background: var(--info-gradient); }

    .pulse-text {
        animation: pulse-animation 1.5s infinite ease-in-out;
        display: inline-block;
    }
    @@keyframes pulse-animation {
        0% { opacity: 1; }
        50% { opacity: 0.5; transform: scale(1.05); }
        100% { opacity: 1; }
    }
</style>

<div class="container-fluid py-4">
    <!-- Hero Section -->
    <div class="hero-section d-flex flex-column flex-md-row justify-content-between align-items-center px-4" style="text-align: left; margin-top: -1.5rem; margin-bottom: 2rem;">
        <div class="position-relative z-1 text-center text-md-start mb-3 mb-md-0">
            <h1 class="hero-title fw-bold mb-2 text-white"><i class="lni lni-grid-alt me-2"></i>Panel de Mesas</h1>
            <p class="mb-0 text-white-50 fs-5">Gestión de ocupación y cuentas abiertas en restaurante.</p>
        </div>
        <div class="position-relative z-1">
            <div class="d-flex flex-wrap justify-content-center gap-2 text-sm">
                <span class="badge bg-success bg-opacity-25 text-white border border-success px-3 py-2 rounded-pill"><i class="lni lni-checkmark-circle me-1"></i>Libre</span>
                <span class="badge bg-warning bg-opacity-25 text-white border border-warning px-3 py-2 rounded-pill"><i class="lni lni-user me-1"></i>Ocupada</span>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm border-0 mb-4 rounded-4">
            <i class="lni lni-warning me-2"></i> @TempData["Error"]
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success shadow-sm border-0 mb-4 rounded-4">
            <i class="lni lni-checkmark me-2"></i> @TempData["Success"]
        </div>
    }

    <div class="row g-4">
        @for (int i = 1; i <= totalMesas; i++)
        {
            var pedidoMesa = Model.FirstOrDefault(p => p.NumeroMesa == i);
            bool ocupada = pedidoMesa != null;

            <div class="col-6 col-md-4 col-lg-3">
                @if (ocupada)
                {
                    bool platosListos = pedidoMesa.Items.Any(item => item.Estado == PedidoEstado.Listo);
                    string avatarBg = platosListos ? "bg-gradient-info text-white" : "bg-gradient-warning text-white";
                    
                    <a href="@Url.Action("Editar", "Pedidos", new { id = pedidoMesa.Id_Venta })" class="text-decoration-none">
                        <div class="premium-card" style="border-left: 4px solid @(platosListos ? "#0dcaf0" : "#f59e0b");">
                            <div class="card-body p-4">
                                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start mb-3 gap-2">
                                    <div class="d-flex align-items-center gap-3 w-100">
                                        <div class="avatar @avatarBg rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5 shadow-sm flex-shrink-0" style="width: 48px; height: 48px;">
                                            @i
                                        </div>
                                        <div class="overflow-hidden">
                                            <h6 class="mb-0 text-dark fw-bold">Mesa @i</h6>
                                            @if(platosListos)
                                            {
                                                <small class="text-info fw-bold pulse-text text-truncate d-block"><i class="lni lni-bell me-1"></i>¡Comida Lista!</small>
                                            }
                                            else
                                            {
                                                <small class="text-warning fw-bold text-truncate d-block">Ocupada</small>
                                            }
                                        </div>
                                    </div>
                                    <span class="badge bg-light text-dark border rounded-pill flex-shrink-0 d-none d-sm-block">
                                        #@pedidoMesa.Id_Venta
                                    </span>
                                </div>
                                
                                <div class="mb-3">
                                    <p class="mb-1 text-muted text-sm text-truncate" title="@pedidoMesa.Cliente"><i class="lni lni-user me-2"></i>@pedidoMesa.Cliente</p>
                                    <p class="mb-0 text-muted text-sm"><i class="lni lni-timer me-2"></i>@pedidoMesa.Fecha.ToString("HH:mm")</p>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top">
                                    <span class="text-muted text-sm">@pedidoMesa.Items.Sum(x => x.Cantidad) ítems</span>
                                    <h5 class="mb-0 fw-bold text-dark">@pedidoMesa.Total.ToString("C", numberFormat)</h5>
                                </div>
                            </div>
                        </div>
                    </a>
                }
                else
                {
                    <a href="@Url.Action("NuevaMesa", "Pedidos", new { numeroMesa = i })" class="text-decoration-none">
                        <div class="premium-card" style="border-left: 4px solid #10b981; background-color: #f8fafc;">
                            <div class="card-body p-4 d-flex flex-column justify-content-center align-items-center text-center opacity-75" style="transition: opacity 0.2s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.75'">
                                <div class="avatar bg-gradient-success text-white rounded-circle d-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 56px; height: 56px;">
                                    <h3 class="mb-0 fw-bold text-white">@i</h3>
                                </div>
                                <h6 class="text-secondary fw-bold mb-2">Mesa @i</h6>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-3">Libre</span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>
