@model VentaFacil.web.Models.Dto.CajaDto
<div class="caja-abrir-wrapper">
    <div class="hero-section d-flex flex-column flex-md-row justify-content-between align-items-center px-4 mb-4" style="margin-top: -1.5rem;">
        <div class="position-relative z-1 text-center text-md-start mb-3 mb-md-0 d-flex align-items-center gap-3">
            <div class="icon-box bg-white bg-opacity-20 text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                <i class="lni lni-wallet fs-4"></i>
            </div>
            <div>
                <h1 class="hero-title fw-bold mb-1 text-white">Apertura de Caja</h1>
                <p class="mb-0 text-white-50 fs-6">Inicia la jornada laboral registrando el fondo inicial.</p>
            </div>
        </div>
        <div class="position-relative z-1 d-none d-md-block text-end">
            <div class="breadcrumb-wrapper">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0 justify-content-end">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="text-white-50">Inicio</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Listar", "Caja")" class="text-white-50">Control de Caja</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Abrir</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="premium-card p-4 shadow-sm border-0">
                <div class="text-center mb-4 pt-2">
                    <div class="avatar bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 64px; height: 64px;">
                        <i class="lni lni-save fs-2"></i>
                    </div>
                    <h4 class="fw-bold text-dark">Arqueo Inicial</h4>
                    <p class="text-muted small">Ingrese la cantidad de efectivo con la que inicia la caja.</p>
                </div>

                <form asp-action="Abrir">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger rounded-3 p-3 mb-3"></div>
                    
                    <div class="mb-4">
                        <label asp-for="Monto_Inicial" class="form-label text-xs fw-bold text-muted text-uppercase mb-2 ms-2">Monto de Apertura (₡)</label>
                        <div class="input-group">
                            <span class="input-group-text rounded-start-pill px-3 bg-light border-end-0 text-muted fw-bold">₡</span>
                            <input asp-for="Monto_Inicial" class="form-control rounded-end-pill px-4" placeholder="0.00" required />
                        </div>
                        <span asp-validation-for="Monto_Inicial" class="text-xs text-danger mt-1 ms-2"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="main-btn primary-btn btn-hover rounded-pill py-3 fw-bold">
                            <i class="lni lni-play me-2"></i> Abrir Jornada de Caja
                        </button>
                        <a asp-action="Listar" class="main-btn dark-btn-outline btn-hover rounded-pill py-2 text-center">
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
