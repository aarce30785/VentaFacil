@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
<aside class="sidebar-nav-wrapper">
    <div class="navbar-logo">
        <a asp-controller="Home" asp-action="Index">
            <h3 class="text-primary mb-0" style="font-family: 'Merriweather', serif; font-weight: 700;">
                <i class="fas fa-store-alt me-2" style="color: #365CF5;"></i>VentaFácil
            </h3>
        </a>
    </div>
    <span class="divider"><hr /></span>

    <nav class="sidebar-nav">
        <ul>
            <li class="nav-item">
                <a asp-controller="Home" asp-action="Index">
                    <span class="icon">
                        <i class="fas fa-tachometer-alt"></i>
                    </span>
                    <span class="text">Dashboard</span>
                </a>
                <a asp-controller="Menu" asp-action="Index" target="_blank">
                    <i class="fas fa-book-open me-2"></i> Menú Público
                </a>
            
            </li>
            
            <li class="nav-item">
                <a asp-controller="Pedidos" asp-action="Mesas">
                    <span class="icon">
                        <i class="fas fa-th-large"></i>
                    </span>
                    <span class="text">Panel de Mesas</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-controller="Pedidos" asp-action="Index">
                    <span class="icon">
                        <i class="fas fa-utensils"></i>
                    </span>
                    <span class="text">Pedidos</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-controller="Pedidos" asp-action="Cocina">
                    <span class="icon">
                        <i class="fas fa-chef-hat"></i>
                    </span>
                    <span class="text">Cocina (KDS)</span>
                </a>
            </li>

            

            <span class="divider"><hr /></span>

            

            <li class="nav-item">
                <a href="/Producto/Listar">
                    <span class="icon">
                        <i class="fas fa-shopping-bag"></i>
                    </span>
                    <span class="text">Productos</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-controller="Inventario" asp-action="Listar">
                    <span class="icon">
                        <i class="fas fa-boxes"></i>
                    </span>
                    <span class="text">Inventario</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-controller="Facturacion" asp-action="Index">
                    <span class="icon">
                        <i class="fas fa-file-invoice-dollar"></i>
                    </span>
                    <span class="text">Facturación</span>
                </a>
            </li>

            

            <span class="divider"><hr /></span>
            
            @if (User.IsInRole("Administrador"))
            {
                <li class="nav-item">
                    <a asp-controller="Planilla" asp-action="Index">
                        <span class="icon">
                            <i class="fas fa-user-clock"></i>
                        </span>
                        <span class="text">Planilla</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Planilla" asp-action="AprobacionHoras">
                        <span class="icon">
                            <i class="fas fa-clipboard-check"></i>
                        </span>
                        <span class="text">Aprobación de Horas</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Configuracion" asp-action="Index">
                        <span class="icon">
                            <i class="fas fa-cogs"></i>
                        </span>
                        <span class="text">Configuración</span>
                    </a>
                </li>

                

                <span class="divider"><hr /></span>

                <li class="nav-item">
                    <a asp-controller="Admin" asp-action="Index">
                        <span class="icon">
                            <i class="fas fa-cogs"></i>
                        </span>
                        <span class="text">Administración</span>
                    </a>
                </li>
                
                <li class="nav-item">
                    <a asp-controller="Reportes" asp-action="Index">
                        <span class="icon">
                            <i class="fas fa-chart-bar"></i>
                        </span>
                        <span class="text">Reportes</span>
                    </a>
                </li>
            }

            @if (User.IsInRole("Administrador") || User.IsInRole("Cajero"))
            {
                <li class="nav-item">
                    <a asp-controller="Caja" asp-action="Listar">
                        <span class="icon">
                            <i class="fas fa-cash-register"></i>
                        </span>
                        <span class="text">Caja</span>
                    </a>
                </li>

                
            }
        </ul>
    </nav>
    
</aside>
