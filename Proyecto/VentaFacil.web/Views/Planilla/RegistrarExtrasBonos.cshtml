@using VentaFacil.web.Models.Dto
@model RegistrarExtrasBonosDto

@{
    ViewData["Title"] = "Extras y Bonificaciones";
    Layout = "~/Views/Shared/_LayoutPlantilla.cshtml";
}

<div class="extras-bonos-wrapper">
    <div class="hero-section d-flex flex-column flex-md-row justify-content-between align-items-center px-4 mb-4" style="margin-top: -1.5rem;">
        <div class="position-relative z-1 text-center text-md-start mb-3 mb-md-0">
            <h1 class="hero-title fw-bold mb-2 text-white"><i class="lni lni-star me-2"></i>Extras y Bonificaciones</h1>
            <p class="mb-0 text-white-50 fs-5">Gestión de horas extras e incentivos por planilla.</p>
        </div>
        <div class="position-relative z-1 d-none d-md-block">
            <div class="breadcrumb-wrapper">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="text-white-50">Inicio</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Planilla")" class="text-white-50">Planilla</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Extras y Bonos</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

<div class="form-layout-wrapper">

    @* ============================================================
       SECCIÓN A – SELECTOR DE PLANILLA (compartido para ambas secciones)
       ============================================================ *@
    <div class="mx-4">
        @* Selección de Planilla *@
        <div class="premium-card p-4 mb-4">
            <div class="mb-4 d-flex align-items-center">
                <div class="icon-box bg-primary bg-opacity-10 text-primary rounded-3 me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                    <i class="lni lni-layers"></i>
                </div>
                <h5 class="fw-bold mb-0">Seleccionar Planilla del Empleado</h5>
            </div>
            
            <div class="row align-items-end g-3">
                <div class="col-md-9">
                    <label class="form-label text-xs fw-bold text-muted text-uppercase mb-2 ms-2">Colaborador y Periodo</label>
                    <select id="selectorPlanilla" class="form-select rounded-pill">
                        <option value="">-- Seleccione una planilla activa --</option>
                        @if (ViewBag.Planillas != null)
                        {
                            foreach (SelectListItem item in ViewBag.Planillas)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3 text-end">
                    <button type="button" id="btnCargarBonificaciones" class="main-btn primary-btn btn-hover rounded-pill w-100 py-2" disabled>
                        <i class="lni lni-reload me-1"></i> Cargar Información
                    </button>
                </div>
            </div>
        </div>

    @* ============================================================
       SECCIÓN B – HORAS EXTRAS
       ============================================================ *@
        @* Registro de Horas Extras *@
        <div class="premium-card p-4 mb-4">
            <div class="mb-4 d-flex align-items-center">
                <div class="icon-box bg-warning bg-opacity-10 text-warning rounded-3 me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                    <i class="lni lni-timer"></i>
                </div>
                <h5 class="fw-bold mb-0">Registrar Horas Extras</h5>
            </div>

            <div class="alert alert-warning bg-warning bg-opacity-10 border-0 rounded-3 mb-4 d-flex align-items-center">
                <i class="lni lni-warning fs-4 me-2"></i>
                <span class="small"><strong>Límite legal:</strong> Máximo 4 horas extras por jornada laboral.</span>
            </div>

            <form id="formExtras">
                @Html.AntiForgeryToken()
                <input type="hidden" id="extrasIdPlanilla" name="Id_Planilla" value="" />
                <div class="row align-items-end g-3">
                    <div class="col-md-4">
                        <label class="form-label text-xs fw-bold text-muted text-uppercase mb-2 ms-2">Cantidad de Horas</label>
                        <input type="number" id="campoHorasExtras" name="HorasExtras" class="form-control rounded-pill"
                               step="0.5" min="0" max="4" placeholder="Ej: 2.0" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-xs fw-bold text-muted text-uppercase mb-2 ms-2">Observaciones</label>
                        <input type="text" id="campoObservacionesExtras" name="Observaciones" class="form-control rounded-pill"
                               placeholder="Motivo de las horas extra..." />
                    </div>
                    <div class="col-md-2 text-end">
                        <button type="submit" id="btnGuardarExtras" class="main-btn warning-btn btn-hover rounded-pill w-100 py-2" disabled>
                            <i class="lni lni-save me-1"></i> Guardar
                        </button>
                    </div>
                </div>
            </form>
        </div>

    @* ============================================================
       SECCIÓN C – BONIFICACIONES INDIVIDUALES
       ============================================================ *@
        @* Bonificaciones *@
        <div class="premium-card p-0 overflow-hidden mb-5">
            <div class="p-4 border-bottom d-flex justify-content-between align-items-center bg-light bg-opacity-50">
                <div class="d-flex align-items-center">
                    <div class="icon-box bg-success bg-opacity-10 text-success rounded-3 me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                        <i class="lni lni-star"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Bonificaciones Individuales</h5>
                </div>
                <button type="button" id="btnNuevaBonificacion" class="main-btn success-btn btn-hover rounded-pill px-4 py-2" disabled>
                    <i class="lni lni-plus me-1"></i> Agregar Bono
                </button>
            </div>
            
            <div id="tablaBonificacionesWrapper">
                <div class="text-center text-muted py-5" id="msgSinPlanilla">
                    <i class="lni lni-information fs-1 opacity-25 mb-3"></i>
                    <p>Seleccione una planilla para ver sus bonificaciones cargadas.</p>
                </div>
                <div id="tablaBonificacionesContainer" class="table-responsive" style="display:none;">
                    <table class="table premium-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Motivo</th>
                                <th>Monto (₡)</th>
                                <th>Fecha</th>
                                <th>Registrado</th>
                                <th class="text-center pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tablaBonificacionesCuerpo"></tbody>
                    </table>
                    <div id="noHayBonificaciones" class="text-center text-muted py-5" style="display:none;">
                        <i class="lni lni-tag fs-1 opacity-25 mb-3"></i>
                        <p>No hay bonificaciones registradas para esta planilla.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@* ============================================================
   MODAL – Agregar / Editar Bonificación
   ============================================================ *@
<!-- Modal Agregar / Editar Bonificación -->
<div class="modal fade" id="modalBonificacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-success" id="modalBonificacionLabel">
                    <i class="lni lni-star me-2"></i> Bonificación
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formBonificacion" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="bonId" value="" />
                <input type="hidden" id="bonIdPlanilla" value="" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label text-xs fw-bold text-muted text-uppercase mb-2">Motivo <span class="text-danger">*</span></label>
                        <input type="text" id="bonMotivo" class="form-control rounded-pill" placeholder="Ej: Bono por ventas, incentivo cumpleaños..." maxlength="255" required />
                        <div class="invalid-feedback text-xs">El motivo es obligatorio.</div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-xs fw-bold text-muted text-uppercase mb-2">Monto (₡) <span class="text-danger">*</span></label>
                            <input type="number" id="bonMonto" class="form-control rounded-pill" step="0.01" min="1" placeholder="0.00" required />
                            <div class="invalid-feedback text-xs">El monto debe ser mayor a 0.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-xs fw-bold text-muted text-uppercase mb-2">Fecha <span class="text-danger">*</span></label>
                            <input type="date" id="bonFecha" class="form-control rounded-pill" required />
                            <div class="invalid-feedback text-xs">La fecha es obligatoria.</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="main-btn dark-btn-outline btn-hover rounded-pill px-4 py-2" data-bs-dismiss="modal">
                        <i class="lni lni-close me-1"></i> Cancelar
                    </button>
                    <button type="submit" class="main-btn success-btn btn-hover rounded-pill px-4 py-2" id="btnConfirmarBonificacion">
                        <i class="lni lni-save me-1"></i> <span id="txtBtnConfirmar">Guardar</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ============================================================
   MODAL – Historial de Auditoría
   ============================================================ *@
<!-- Modal Historial de Auditoría -->
<div class="modal fade" id="modalAuditoria" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-primary">
                    <i class="lni lni-history me-2"></i> Historial de Cambios
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="loadingAuditoria" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">Cargando historial...</p>
                </div>
                <div id="auditoriaCuerpoWrapper" style="display:none;" class="table-responsive">
                    <table class="table premium-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Anterior</th>
                                <th>Nuevo</th>
                                <th>Acción</th>
                                <th>Responsable</th>
                            </tr>
                        </thead>
                        <tbody id="auditoriaCuerpo"></tbody>
                    </table>
                    <div id="sinHistorial" class="text-center text-muted py-4" style="display:none;">
                        <i class="lni lni-information fs-1 opacity-25 mb-2"></i>
                        <p>No hay registros de cambios para esta bonificación.</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="main-btn dark-btn-outline btn-hover rounded-pill px-4 py-2" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    'use strict';

    // ─── Helpers ───────────────────────────────────────────────────────────────
    const antiforgery = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    function fmt(n) {
        return '₡' + Number(n).toLocaleString('es-CR', { minimumFractionDigits: 2 });
    }

    function today() {
        return new Date().toISOString().split('T')[0];
    }

    // ─── State ─────────────────────────────────────────────────────────────────
    let planillaActual = null;

    // ─── Selector de planilla ──────────────────────────────────────────────────
    document.getElementById('selectorPlanilla').addEventListener('change', function () {
        const val = this.value;
        const hasPlanilla = !!val;
        document.getElementById('btnCargarBonificaciones').disabled = !hasPlanilla;
        document.getElementById('btnGuardarExtras').disabled = !hasPlanilla;
        document.getElementById('btnNuevaBonificacion').disabled = !hasPlanilla;
        if (!hasPlanilla) {
            planillaActual = null;
            document.getElementById('tablaBonificacionesContainer').style.display = 'none';
            document.getElementById('msgSinPlanilla').style.display = '';
        }
    });

    document.getElementById('btnCargarBonificaciones').addEventListener('click', function () {
        const sel = document.getElementById('selectorPlanilla');
        planillaActual = sel.value;
        document.getElementById('extrasIdPlanilla').value = planillaActual;
        cargarBonificaciones(planillaActual);
    });

    // ─── Cargar tabla bonificaciones ───────────────────────────────────────────
    async function cargarBonificaciones(idPlanilla) {
        try {
            const res = await fetch(`/Planilla/ObtenerBonificaciones?idPlanilla=${idPlanilla}`);
            const json = await res.json();
            if (!json.success) { return; }
            renderTabla(json.data);
        } catch (e) {
            console.error(e);
        }
    }

    function renderTabla(data) {
        document.getElementById('msgSinPlanilla').style.display = 'none';
        document.getElementById('tablaBonificacionesContainer').style.display = '';
        const tbody = document.getElementById('tablaBonificacionesCuerpo');
        tbody.innerHTML = '';

        if (!data || data.length === 0) {
            document.getElementById('noHayBonificaciones').style.display = '';
            return;
        }
        document.getElementById('noHayBonificaciones').style.display = 'none';

        data.forEach((b, idx) => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="ps-4">
                    <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3">
                        ${escapeHtml(b.Motivo)}
                    </span>
                </td>
                <td class="fw-bold text-success">${fmt(b.Monto)}</td>
                <td><span class="text-dark small">${b.Fecha}</span></td>
                <td><span class="text-muted small">${b.FechaRegistro}</span></td>
                <td class="text-center pe-4">
                    <div class="d-flex justify-content-center gap-2">
                        <button class="btn btn-sm btn-white text-primary rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: white;" onclick="abrirEditar(${b.Id}, '${escapeHtml(b.Motivo)}', ${b.Monto}, '${b.Fecha}')" title="Editar">
                            <i class="lni lni-pencil"></i>
                        </button>
                        <button class="btn btn-sm btn-white text-danger rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: white;" onclick="confirmarEliminar(${b.Id})" title="Eliminar">
                            <i class="lni lni-trash-can"></i>
                        </button>
                        <button class="btn btn-sm btn-white text-secondary rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: white;" onclick="verHistorial(${b.Id})" title="Auditoría">
                            <i class="lni lni-history"></i>
                        </button>
                    </div>
                </td>`;
            tbody.appendChild(tr);
        });
    }

    function escapeHtml(str) {
        return String(str).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    // ─── Modal Bonificación – Nuevo ───────────────────────────────────────────
    document.getElementById('btnNuevaBonificacion').addEventListener('click', () => {
        document.getElementById('bonId').value = '';
        document.getElementById('bonIdPlanilla').value = planillaActual;
        document.getElementById('bonMotivo').value = '';
        document.getElementById('bonMonto').value = '';
        document.getElementById('bonFecha').value = today();
        document.getElementById('txtBtnConfirmar').textContent = 'Guardar';
        document.getElementById('modalBonificacionLabel').innerHTML = '<i class="lni lni-star me-2"></i>Nueva Bonificación';
        document.getElementById('formBonificacion').classList.remove('was-validated');
        new bootstrap.Modal(document.getElementById('modalBonificacion')).show();
    });

    // ─── Modal Bonificación – Editar (global para onclick) ────────────────────
    window.abrirEditar = function (id, motivo, monto, fecha) {
        document.getElementById('bonId').value = id;
        document.getElementById('bonIdPlanilla').value = planillaActual;
        document.getElementById('bonMotivo').value = motivo;
        document.getElementById('bonMonto').value = monto;
        document.getElementById('bonFecha').value = fecha;
        document.getElementById('txtBtnConfirmar').textContent = 'Actualizar';
        document.getElementById('modalBonificacionLabel').innerHTML = '<i class="lni lni-pencil me-2"></i>Editar Bonificación';
        document.getElementById('formBonificacion').classList.remove('was-validated');
        new bootstrap.Modal(document.getElementById('modalBonificacion')).show();
    };

    // ─── Guardar / Editar (submit del form) ───────────────────────────────────
    document.getElementById('formBonificacion').addEventListener('submit', async function (e) {
        e.preventDefault();
        this.classList.add('was-validated');
        if (!this.checkValidity()) return;

        const id        = document.getElementById('bonId').value;
        const idPlanilla = parseInt(document.getElementById('bonIdPlanilla').value);
        const motivo    = document.getElementById('bonMotivo').value.trim();
        const monto     = parseFloat(document.getElementById('bonMonto').value);
        const fecha     = document.getElementById('bonFecha').value;
        const esEdicion = !!id;

        const url = esEdicion
            ? `/Planilla/EditarBonificacion?id=${id}`
            : `/Planilla/GuardarBonificacion`;

        const payload = { Id_Planilla: idPlanilla, Motivo: motivo, Monto: monto, Fecha: fecha };

        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': antiforgery()
                },
                body: JSON.stringify(payload)
            });
            const json = await res.json();

            bootstrap.Modal.getInstance(document.getElementById('modalBonificacion'))?.hide();

            if (json.success ?? json.Success) {
                Swal.fire({
                    icon: 'success',
                    title: esEdicion ? 'Bonificación actualizada' : 'Bonificación agregada',
                    text: json.message ?? json.Message,
                    timer: 2000,
                    showConfirmButton: false
                });
                cargarBonificaciones(planillaActual);
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: json.message ?? json.Message });
            }
        } catch (err) {
            Swal.fire({ icon: 'error', title: 'Error de red', text: err.message });
        }
    });

    // ─── Eliminar ─────────────────────────────────────────────────────────────
    window.confirmarEliminar = function (id) {
        Swal.fire({
            title: '¿Eliminar bonificación?',
            text: 'Esta acción no se puede deshacer.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc2626',
            cancelButtonColor: '#6b7280',
            confirmButtonText: 'Sí, eliminar',
            cancelButtonText: 'Cancelar'
        }).then(async (result) => {
            if (!result.isConfirmed) return;

            const form = new FormData();
            form.append('__RequestVerificationToken', antiforgery());

            try {
                const res = await fetch(`/Planilla/EliminarBonificacion?id=${id}`, {
                    method: 'POST',
                    headers: { 'X-CSRF-TOKEN': antiforgery() },
                    body: form
                });
                const json = await res.json();
                if (json.success ?? json.Success) {
                    Swal.fire({ icon: 'success', title: 'Eliminada', text: json.message ?? json.Message, timer: 1800, showConfirmButton: false });
                    cargarBonificaciones(planillaActual);
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: json.message ?? json.Message });
                }
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Error de red', text: err.message });
            }
        });
    };

    // ─── Historial de Auditoría ───────────────────────────────────────────────
    window.verHistorial = async function (id) {
        document.getElementById('auditoriaCuerpoWrapper').style.display = 'none';
        document.getElementById('loadingAuditoria').style.display = '';
        document.getElementById('sinHistorial').style.display = 'none';
        new bootstrap.Modal(document.getElementById('modalAuditoria')).show();

        try {
            const res = await fetch(`/Planilla/ObtenerAuditoriaBonificacion?id=${id}`);
            const json = await res.json();

            document.getElementById('loadingAuditoria').style.display = 'none';
            document.getElementById('auditoriaCuerpoWrapper').style.display = '';

            const tbody = document.getElementById('auditoriaCuerpo');
            tbody.innerHTML = '';

            if (!json.data || json.data.length === 0) {
                document.getElementById('sinHistorial').style.display = '';
                return;
            }

            json.data.forEach(a => {
                const esElim = a.MontoNuevo === 0 && a.MotivoCambio?.includes('Eliminaci');
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><span class="text-dark small">${a.FechaCambio}</span></td>
                    <td><span class="text-danger text-decoration-line-through small">${fmt(a.MontoAnterior)}</span></td>
                    <td><span class="${esElim ? 'text-danger' : 'text-success fw-bold'} small">${esElim ? '<em>Eliminada</em>' : fmt(a.MontoNuevo)}</span></td>
                    <td><span class="text-muted small">${escapeHtml(a.MotivoCambio ?? '-')}</span></td>
                    <td><span class="badge rounded-pill bg-light text-dark border px-3">${escapeHtml(a.Responsable)}</span></td>`;
                tbody.appendChild(tr);
            });
        } catch (err) {
            document.getElementById('loadingAuditoria').style.display = 'none';
            document.getElementById('auditoriaCuerpoWrapper').style.display = '';
            document.getElementById('sinHistorial').style.display = '';
        }
    };

    // ─── Horas Extras (form submit) ───────────────────────────────────────────
    document.getElementById('formExtras').addEventListener('submit', async function (e) {
        e.preventDefault();

        const id_planilla = document.getElementById('extrasIdPlanilla').value;
        const horas       = parseFloat(document.getElementById('campoHorasExtras').value || '0');
        const obs         = document.getElementById('campoObservacionesExtras').value;

        if (!id_planilla) {
            Swal.fire({ icon: 'warning', title: 'Atención', text: 'Seleccione una planilla primero.' });
            return;
        }

        const form = new FormData();
        form.append('Id_Planilla', id_planilla);
        form.append('HorasExtras', horas);
        form.append('MontoBonificaciones', 0);
        form.append('Observaciones', obs);
        form.append('__RequestVerificationToken', antiforgery());

        try {
            const res  = await fetch('/Planilla/RegistrarExtrasBonos', { method: 'POST', body: form });
            const json = await res.json().catch(() => null);

            // Distinguir respuesta: puede ser redirect (HTML) si Success → TempData
            // Manejar ambas vías
            if (!json) {
                // Respuesta de redirección exitosa
                Swal.fire({ icon: 'success', title: 'Guardado', text: 'Horas extras registradas.', timer: 2000, showConfirmButton: false });
                return;
            }

            if (json.success === false && json.message && json.message.includes('exceden límite legal')) {
                Swal.fire({
                    icon: 'error',
                    title: 'Operación bloqueada',
                    text: 'Horas extras exceden límite legal',
                    confirmButtonColor: '#dc2626'
                });
            } else if (json.success === false) {
                Swal.fire({ icon: 'error', title: 'Error', text: json.message });
            } else {
                Swal.fire({ icon: 'success', title: 'Guardado', text: json.message ?? 'Horas extras registradas.', timer: 2000, showConfirmButton: false });
            }
        } catch (err) {
            Swal.fire({ icon: 'error', title: 'Error de red', text: err.message });
        }
    });

})();
</script>
}