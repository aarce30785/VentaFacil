@model VentaFacil.web.Models.Dto.CajaDto
<div class="caja-cerrar-wrapper">
    <div class="hero-section d-flex flex-column flex-md-row justify-content-between align-items-center px-4 mb-4" style="margin-top: -1.5rem;">
        <div class="position-relative z-1 text-center text-md-start mb-3 mb-md-0 d-flex align-items-center gap-3">
            <div class="icon-box bg-white bg-opacity-20 text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                <i class="lni lni-lock fs-4"></i>
            </div>
            <div>
                <h1 class="hero-title fw-bold mb-1 text-white">Cierre de Caja</h1>
                <p class="mb-0 text-white-50 fs-6">Finaliza la jornada y registra el balance final.</p>
            </div>
        </div>
        <div class="position-relative z-1 d-none d-md-block text-end">
            <div class="breadcrumb-wrapper">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0 justify-content-end">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="text-white-50">Inicio</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Listar", "Caja")" class="text-white-50">Control de Caja</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Cerrar</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="premium-card p-4 shadow-sm border-0">
                <div class="text-center mb-4 pt-2">
                    <div class="avatar bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 64px; height: 64px;">
                        <i class="lni lni-exit fs-2"></i>
                    </div>
                    <h4 class="fw-bold text-dark">Resumen de Cierre</h4>
                    <p class="text-muted small">Verifique los montos antes de confirmar el cierre definitivo.</p>
                </div>

                <form asp-action="Cerrar">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger rounded-3 p-3 mb-4"></div>
                    <input type="hidden" asp-for="Id_Caja" />
                    <input type="hidden" asp-for="Id_Usuario" />
                    <input type="hidden" asp-for="Fecha_Apertura" />
                    <input type="hidden" asp-for="Estado" />

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label text-xs fw-bold text-muted text-uppercase mb-2 ms-2">Fecha Apertura</label>
                            <input class="form-control rounded-pill bg-light border-0 px-4" value="@Model.Fecha_Apertura.ToString("g")" readonly />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Fecha_Cierre" class="form-label text-xs fw-bold text-muted text-uppercase mb-2 ms-2">Fecha Cierre</label>
                            <input asp-for="Fecha_Cierre" class="form-control rounded-pill bg-light border-0 px-4" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-xs fw-bold text-muted text-uppercase mb-2 ms-2">Fondo Inicial (₡)</label>
                            <div class="input-group">
                                <span class="input-group-text rounded-start-pill px-3 bg-light border-end-0 text-muted fw-bold">₡</span>
                                <input asp-for="Monto_Inicial" class="form-control rounded-end-pill px-4 bg-light" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-xs fw-bold text-muted text-uppercase mb-2 ms-2 text-danger">Monto Final en Caja (₡)</label>
                            <div class="input-group shadow-sm rounded-pill overflow-hidden">
                                <span class="input-group-text rounded-start-pill px-3 bg-danger bg-opacity-10 text-danger border-0 border-end fw-bold">₡</span>
                                <input asp-for="Monto" class="form-control px-4 border-0 fw-bold text-danger fs-5" placeholder="0.00" required />
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning border-0 bg-warning bg-opacity-10 text-warning-700 rounded-4 p-3 mb-4 d-flex align-items-center gap-3">
                        <i class="lni lni-warning fs-3"></i>
                        <p class="mb-0 small fw-medium">Al cerrar la caja, no se podrán registrar más movimientos hasta una nueva apertura. El sistema generará el diferencial automáticamente.</p>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="main-btn danger-btn btn-hover rounded-pill py-3 fw-bold shadow-sm">
                            <i class="lni lni-check-box me-2"></i> Confirmar Cierre de Caja
                        </button>
                        <a asp-action="Listar" class="main-btn dark-btn-outline btn-hover rounded-pill py-2 text-center mt-2">
                            Cancelar y volver
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
