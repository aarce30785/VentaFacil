@using VentaFacil.web.Models.Configuracion
@{
    ViewData["Title"] = "Configuración de Deducciones";
    Layout = "~/Views/Shared/_LayoutPlantilla.cshtml";
    var deducciones = ViewBag.Deducciones as List<DeduccionLey>;
    var impuestos = ViewBag.Impuestos as List<ImpuestoRenta>;

    // Diccionario de definiciones
    var definiciones = new Dictionary<string, string>
    {
        { "SEM", "Seguro de Enfermedad y Maternidad (CCSS)" },
        { "IVM", "Invalidez, Vejez y Muerte (CCSS)" },
        { "LPT", "Ley de Protección al Trabajador (Banco Popular)" }
    };
}

<div class="settings-wrapper">
    <!-- Hero Section -->
    <div class="hero-section d-flex flex-column flex-md-row justify-content-between align-items-center px-4" style="text-align: left; margin-top: -1.5rem; margin-bottom: 2rem;">
        <div class="position-relative z-1 text-center text-md-start mb-3 mb-md-0">
            <h1 class="hero-title fw-bold mb-2 text-white"><i class="lni lni-cog me-2"></i>Configuración General</h1>
            <p class="mb-0 text-white-50 fs-5">Administración de deducciones e impuestos de renta.</p>
        </div>
        <div class="position-relative z-1 d-none d-md-block">
            <div class="breadcrumb-wrapper">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a asp-controller="Planilla" asp-action="Index" class="text-white-50">Planilla</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Configuración</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <!-- Alertas -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible bg-success text-white border-0 fade show mx-4 mb-4" role="alert">
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            <strong>Éxito:</strong> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible bg-danger text-white border-0 fade show mx-4 mb-4" role="alert">
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            <strong>Error:</strong> @TempData["Error"]
        </div>
    }

    <div class="row g-4 mx-2 pb-5">
        <!-- DEDUCCIONES DE LEY -->
        <div class="col-12">
            <div class="premium-card">
                <div class="p-4 border-bottom">
                    <h5 class="fw-bold mb-1"><i class="lni lni-invest-monitor me-2 text-primary"></i>Deducciones de Ley</h5>
                    <p class="text-sm text-muted mb-0">Cargas sociales CCSS y Banco Popular</p>
                </div>
                <div class="p-4">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="text-secondary text-uppercase fs-7 bg-light">
                                <tr>
                                    <th class="border-0 rounded-start ps-3">Concepto</th>
                                    <th class="border-0">Descripción</th>
                                    <th class="border-0 text-center" width="15%">Porcentaje</th>
                                    <th class="border-0 text-center" width="10%">Activo</th>
                                    <th class="border-0 text-end rounded-end pe-3">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (deducciones != null)
                                {
                                    foreach (var item in deducciones)
                                    {
                                        var descripcion = definiciones.ContainsKey(item.Nombre) ? definiciones[item.Nombre] : "Deducción de Ley";
                                        <tr>
                                            <form asp-action="GuardarDeduccion" method="post" style="display: contents;">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <td class="ps-3 border-0 py-3">
                                                    <span class="badge bg-primary bg-opacity-10 text-primary border-0 fw-bold px-3 py-2 rounded-3">@item.Nombre</span>
                                                </td>
                                                <td class="border-0 py-3">
                                                    <span class="text-muted text-sm">@descripcion</span>
                                                </td>
                                                <td class="border-0 py-3">
                                                    <div class="input-group input-group-sm">
                                                        <input type="number" step="0.01" name="porcentaje" value="@item.Porcentaje" 
                                                               class="form-control rounded-start-pill bg-light border-0 text-center fw-bold text-primary" />
                                                        <span class="input-group-text bg-light border-0 text-muted rounded-end-pill px-3">%</span>
                                                    </div>
                                                </td>
                                                <td class="text-center border-0 py-3">
                                                    <div class="form-check form-switch d-flex justify-content-center">
                                                        <input class="form-check-input" type="checkbox" name="activo" value="true" @(item.Activo ? "checked" : "")>
                                                    </div>
                                                </td>
                                                <td class="text-end pe-3 border-0 py-3">
                                                    <button type="submit" class="main-btn success-btn btn-hover btn-sm rounded-circle p-2" title="Guardar">
                                                        <i class="lni lni-checkmark"></i>
                                                    </button>
                                                </td>
                                            </form>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- IMPUESTO DE RENTA -->
        <div class="col-12">
            <div class="premium-card">
                <div class="p-4 border-bottom">
                    <h5 class="fw-bold mb-1"><i class="lni lni-stats-up me-2 text-warning"></i>Impuesto de Renta</h5>
                    <p class="text-sm text-muted mb-0">Tramos vigentes (2025)</p>
                </div>
                <div class="p-4">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="text-secondary text-uppercase fs-7 bg-light">
                                <tr>
                                    <th class="border-0 rounded-start ps-3">Desde (₡)</th>
                                    <th class="border-0">Hasta (₡)</th>
                                    <th class="border-0 text-center">Porcentaje (%)</th>
                                    <th class="border-0 text-end rounded-end pe-3">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (impuestos != null)
                                {
                                    foreach (var item in impuestos)
                                    {
                                        <tr>
                                            <form asp-action="GuardarImpuesto" method="post" style="display: contents;">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <td class="ps-3 border-0 py-3">
                                                    <input type="number" step="0.01" name="limiteInferior" value="@item.LimiteInferior" 
                                                           class="form-control rounded-pill bg-light border-0 px-3 py-2 text-end fw-medium" />
                                                </td>
                                                <td class="border-0 py-3">
                                                    <input type="number" step="0.01" name="limiteSuperior" value="@item.LimiteSuperior" 
                                                           class="form-control rounded-pill bg-light border-0 px-3 py-2 text-end fw-medium" 
                                                           placeholder="Exceso" />
                                                </td>
                                                <td width="15%" class="border-0 py-3 text-center">
                                                    <div class="input-group input-group-sm justify-content-center">
                                                        <input type="number" step="0.01" name="porcentaje" value="@item.Porcentaje" 
                                                               class="form-control rounded-start-pill bg-light border-0 text-center fw-bold" style="max-width: 80px;" />
                                                        <span class="input-group-text bg-light border-0 text-muted rounded-end-pill px-3">%</span>
                                                    </div>
                                                </td>
                                                <td class="text-end pe-3 border-0 py-3">
                                                    <button type="submit" class="main-btn success-btn btn-hover btn-sm rounded-circle p-2" title="Guardar">
                                                        <i class="lni lni-checkmark"></i>
                                                    </button>
                                                </td>
                                            </form>
                                        </tr>
                                    }
                                }
                                <!-- Fila para agregar nuevo -->
                                <tr class="bg-light bg-opacity-50">
                                    <form asp-action="GuardarImpuesto" method="post" style="display: contents;">
                                        <input type="hidden" name="id" value="0" />
                                        <td class="ps-3 border-0 py-3">
                                            <input type="number" step="0.01" name="limiteInferior" 
                                                   class="form-control rounded-pill bg-white border-0 px-3 py-2" placeholder="Nuevo Desde" />
                                        </td>
                                        <td class="border-0 py-3">
                                            <input type="number" step="0.01" name="limiteSuperior" 
                                                   class="form-control rounded-pill bg-white border-0 px-3 py-2" placeholder="Nuevo Hasta" />
                                        </td>
                                        <td class="border-0 py-3 text-center">
                                            <input type="number" step="0.01" name="porcentaje" 
                                                   class="form-control rounded-pill bg-white border-0 px-3 py-2 text-center mx-auto" style="max-width: 100px;" placeholder="%" />
                                        </td>
                                        <td class="text-end pe-3 border-0 py-3">
                                            <button type="submit" class="main-btn primary-btn btn-hover btn-sm rounded-circle p-2" title="Agregar">
                                                <i class="lni lni-plus"></i>
                                            </button>
                                        </td>
                                    </form>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="p-3 bg-light border-top">
                    <p class="text-muted text-sm mb-0 ms-2"><i class="lni lni-information me-2 text-primary"></i> Si deja el campo <strong>"Hasta"</strong> vacío, se considerará como el tramo de <strong>"Exceso"</strong> (infinito).</p>
                </div>
            </div>
        </div>
    </div>
</div>
