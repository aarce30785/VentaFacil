@using VentaFacil.web.Models.Dto
@model NominaDetalleDto
@{
    var cultureCR = new System.Globalization.CultureInfo("es-CR");
    var numberFormat = (System.Globalization.NumberFormatInfo)cultureCR.NumberFormat.Clone();
    numberFormat.CurrencySymbol = "¢";
    ViewData["Title"] = $"Detalle Nómina #{Model?.Id_Nomina}";
    Layout = "~/Views/Shared/_LayoutPlantilla.cshtml";
}

<div class="detalle-nomina-wrapper">
    <div class="hero-section d-flex flex-column flex-md-row justify-content-between align-items-center px-4 mb-4" style="margin-top: -1.5rem;">
        <div class="position-relative z-1 text-center text-md-start mb-3 mb-md-0 d-flex align-items-center gap-3">
            <a href="@Url.Action("Consultar", "Planilla")" class="main-btn dark-btn-outline rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                <i class="lni lni-arrow-left"></i>
            </a>
            <div>
                <h1 class="hero-title fw-bold mb-1 text-white">Nómina #@Model.Id_Nomina</h1>
                <p class="mb-0 text-white-50 fs-6">Detalle completo de pagos y deducciones.</p>
            </div>
        </div>
        <div class="position-relative z-1 d-none d-md-block text-end">
            <div class="breadcrumb-wrapper">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0 justify-content-end">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="text-white-50">Inicio</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Planilla")" class="text-white-50">Planilla</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Detalle</li>
                    </ol>
                </nav>
            </div>
            <div class="mt-2 text-white-50 small">
                <i class="lni lni-calendar"></i> Generada: @Model.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>
    </div>

    <div class="mx-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible bg-success text-white border-0 fade show mb-4" role="alert">
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                <i class="lni lni-checkmark-circle me-2"></i> @TempData["Success"]
            </div>
        }
        
        <div class="row g-4 mb-4">
            <div class="col-lg-3 col-md-6">
                <div class="premium-card p-4 text-center h-100">
                    <div class="text-xs fw-bold text-muted text-uppercase mb-2">Estado</div>
                    @if (Model.Estado == "Generada")
                    {
                        <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 fs-6">Generada</span>
                    }
                    else if (Model.Estado == "Anulada")
                    {
                        <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2 fs-6">Anulada</span>
                    }
                    else
                    {
                        <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-3 py-2 fs-6">@Model.Estado</span>
                    }
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="premium-card p-4 text-center h-100">
                    <div class="text-xs fw-bold text-muted text-uppercase mb-2">Período</div>
                    <div class="icon-box bg-primary bg-opacity-10 text-primary rounded-3 mx-auto mb-2" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                        <i class="lni lni-calendar"></i>
                    </div>
                    <h4 class="fw-bold mb-0 text-dark">Semana @(Model.Semana ?? 0)</h4>
                    <span class="text-muted small">Ejecicio @Model.Anio</span>
                </div>
            </div>
            <div class="col-lg-2 col-md-4">
                <div class="premium-card p-4 text-center h-100">
                    <div class="text-xs fw-bold text-muted text-uppercase mb-3">T. Bruto</div>
                    <h4 class="fw-bold mb-0 text-dark">@Model.TotalBruto.ToString("C", numberFormat)</h4>
                </div>
            </div>
            <div class="col-lg-2 col-md-4">
                <div class="premium-card p-4 text-center h-100">
                    <div class="text-xs fw-bold text-muted text-uppercase mb-3">Deducciones</div>
                    <h4 class="fw-bold mb-0 text-danger">@Model.TotalDeducciones.ToString("C", numberFormat)</h4>
                </div>
            </div>
            <div class="col-lg-2 col-md-4">
                <div class="premium-card p-4 text-center h-100">
                    <div class="text-xs fw-bold text-muted text-uppercase mb-3">T. Neto</div>
                    <h4 class="fw-bold mb-0 text-success">@Model.TotalNeto.ToString("C", numberFormat)</h4>
                </div>
            </div>
        </div>

        <div class="premium-card p-0 overflow-hidden mb-5 shadow-sm border-0">
            <div class="p-4 border-bottom d-flex flex-column flex-md-row justify-content-between align-items-md-center bg-light bg-opacity-50 gap-3">
                <div class="d-flex align-items-center">
                    <div class="icon-box bg-success bg-opacity-10 text-success rounded-3 me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                        <i class="lni lni-users"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Desglose por Empleado</h5>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a href="@Url.Action("ExportarNomina", "Planilla", new { idNomina = Model.Id_Nomina })" class="main-btn primary-btn btn-hover rounded-pill px-4 py-2" target="_blank">
                        <i class="lni lni-empty-file me-2"></i> PDF
                    </a>
                    <a href="@Url.Action("ExportarNominaExcel", "Planilla", new { idNomina = Model.Id_Nomina })" class="main-btn success-btn btn-hover rounded-pill px-4 py-2" target="_blank">
                        <i class="lni lni-graph me-2"></i> Excel
                    </a>
                    @if (Model.Estado != "Anulada")
                    {
                        <button type="button" class="main-btn danger-btn-outline btn-hover rounded-pill px-4 py-2"
                                data-bs-toggle="modal" data-bs-target="#modalAnularDetalle">
                            <i class="lni lni-trash-can me-2"></i> Anular
                        </button>
                    }
                </div>
            </div>

            <div class="table-responsive">
                <table class="table premium-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Colaborador</th>
                            <th class="text-center">Días/H Base</th>
                            <th class="text-center">Extras</th>
                            <th class="text-center">Bonos</th>
                            <th class="text-end">T. Bruto</th>
                            @foreach (var ded in Model.DeduccionesAplicadas)
                            {
                                <th class="text-end text-danger small">
                                    @ded.Nombre (@ded.Porcentaje.ToString("0.##")%)
                                </th>
                            }
                            <th class="text-end text-success">T. Neto</th>
                            <th class="text-center pe-4">Nota</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Detalles)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 36px; height: 36px; font-weight: bold; font-size: 0.8rem;">
                                            @item.NombreUsuario.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark small">@item.NombreUsuario</div>
                                            <div class="text-xs text-muted">@item.Identificacion</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center small text-dark">@item.HorasTrabajadas.ToString("0.##") h</td>
                                <td class="text-center small text-dark">@item.HorasExtras.ToString("0.##") h</td>
                                <td class="text-center small text-info fw-bold">@item.Bonificaciones.ToString("C", numberFormat)</td>
                                <td class="text-end small fw-bold text-dark">@item.SalarioBruto.ToString("C", numberFormat)</td>
                                @foreach (var dd in item.DeduccionesDetalle)
                                {
                                    <td class="text-end text-danger small">
                                        @dd.Monto.ToString("C", numberFormat)
                                    </td>
                                }
                                <td class="text-end fw-bold text-success">@item.SalarioNeto.ToString("C", numberFormat)</td>
                                <td class="text-center pe-4">
                                    @if (!string.IsNullOrWhiteSpace(item.Observaciones))
                                    {
                                        <span class="badge rounded-pill bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-1"
                                              data-bs-toggle="tooltip" data-bs-placement="left" title="@item.Observaciones"
                                              style="cursor:help;">
                                            Nota
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted text-xs">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ── Modal Anular Nómina (DetalleNomina) ──────────────────────────── -->
<!-- Modal Anular Nómina -->
<div class="modal fade" id="modalAnularDetalle" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger">
                    <i class="lni lni-warning me-2"></i> Anular Nómina #@Model.Id_Nomina
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="RevertirNomina" asp-controller="Planilla" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idNomina" value="@Model.Id_Nomina" />

                <div class="modal-body p-4">
                    <div class="alert alert-danger bg-danger bg-opacity-10 border-0 rounded-3 mb-4">
                        <p class="text-danger small mb-0">
                            <strong>Atención:</strong> Esta acción anulará la nómina y liberará sus jornadas laborales para corrección. Esta operación no puede deshacerse.
                        </p>
                    </div>

                    <div class="mb-0">
                        <label for="justificacionDetalleInput" class="form-label text-xs fw-bold text-muted text-uppercase mb-2 ms-2">Motivo / Justificación <span class="text-danger">*</span></label>
                        <textarea name="justificacion" id="justificacionDetalleInput" class="form-control rounded-3" rows="3"
                                  placeholder="Ej: Error en el cálculo de horas del colaborador X..." required minlength="10"></textarea>
                        <div class="form-text small">Mínimo 10 caracteres requeridos para el historial.</div>
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="main-btn dark-btn-outline btn-hover rounded-pill px-4 py-2" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="main-btn danger-btn btn-hover rounded-pill px-4 py-2">
                        <i class="lni lni-trash-can me-2"></i> Confirmar Anulación
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
