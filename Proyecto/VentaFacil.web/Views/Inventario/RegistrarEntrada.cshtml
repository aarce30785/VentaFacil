@model VentaFacil.web.Models.ViewModel.RegistrarEntradaViewModel

@{
    ViewData["Title"] = "Registrar Entrada";
    Layout = "_LayoutPlantilla";
}

    <!-- Hero Section -->
    <div class="hero-section d-flex justify-content-between align-items-center px-4 mb-4" style="text-align: left; margin-top: -1.5rem;">
        <div class="position-relative z-1">
            <h1 class="hero-title fw-bold mb-1 text-white"><i class="lni lni-download me-2"></i>Entrada de Insumos</h1>
            <p class="mb-0 text-white-50 fs-6">Registre el ingreso de mercancía al almacén.</p>
        </div>
        <div class="position-relative z-1 d-none d-md-block text-end">
            <div class="breadcrumb-wrapper">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0 justify-content-end">
                        <li class="breadcrumb-item"><a href="@Url.Action("Listar")" class="text-white-50">Inventario</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Registrar Entrada</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="row justify-content-center pt-2">
        <div class="col-lg-8">
            <div class="premium-card p-4 shadow-sm border-0 mx-2">
                <div class="p-4 border-bottom mb-4 bg-light bg-opacity-50 rounded-3 d-flex align-items-center">
                    <div class="icon-box bg-success bg-opacity-10 text-success rounded-3 me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                        <i class="lni lni-package"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">Detalles de la Entrega</h5>
                        <p class="text-xs text-muted mb-0">Especifique el insumo y la cantidad recibida.</p>
                    </div>
                </div>

                <form asp-action="RegistrarEntrada" method="post" class="px-2">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger rounded-3 p-3 mb-4"></div>

                    <div class="row g-4">
                        <div class="col-12">
                            <label asp-for="IdInventario" class="form-label text-xs fw-bold text-muted text-uppercase mb-2 ms-2">Seleccionar Insumo</label>
                            <select asp-for="IdInventario" asp-items="Model.Inventarios" class="form-select rounded-pill bg-light border-0 px-4 py-2">
                                <option value="">-- Seleccione un insumo del listado --</option>
                            </select>
                            <span asp-validation-for="IdInventario" class="text-xs text-danger mt-1 ms-2"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Cantidad" class="form-label text-xs fw-bold text-muted text-uppercase mb-2 ms-2">Cantidad a Ingresar</label>
                            <div class="input-group">
                                <span class="input-group-text rounded-start-pill px-3 bg-light border-end-0 text-muted fw-bold"><i class="lni lni-plus"></i></span>
                                <input asp-for="Cantidad" type="number" min="1" step="0.01" class="form-control rounded-end-pill px-4" placeholder="0.00" required />
                            </div>
                            <span asp-validation-for="Cantidad" class="text-xs text-danger mt-1 ms-2"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Observaciones" class="form-label text-xs fw-bold text-muted text-uppercase mb-2 ms-2">Observaciones / Nota</label>
                            <textarea asp-for="Observaciones" class="form-control rounded-4 bg-light border-0 px-4 py-3" rows="3" placeholder="Ej: Compra mensual, reposición de stock..." required></textarea>
                            <span asp-validation-for="Observaciones" class="text-xs text-danger mt-1 ms-2"></span>
                        </div>

                        <div class="col-12 mt-5">
                            <div class="d-flex justify-content-between align-items-center pt-4 border-top">
                                <a href="@Url.Action("Listar")" class="main-btn dark-btn-outline btn-hover rounded-pill px-4 py-2">
                                    <i class="lni lni-arrow-left me-2"></i> Cancelar
                                </a>
                                <button type="submit" class="main-btn success-btn btn-hover rounded-pill px-5 py-2">
                                    <i class="lni lni-checkmark-circle me-2"></i> Confirmar Entrada
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
